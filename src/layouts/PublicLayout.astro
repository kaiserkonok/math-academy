---
import '../styles/global.css';
import { createClient } from '../lib/supabase-server';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Math Solution & Exam Center Mymensingh - Your path to mathematical excellence' } = Astro.props;
const currentPath = Astro.url.pathname;

let isLoggedIn = false;
let userRole = '';
try {
  const { supabase } = createClient(Astro.request, Astro.cookies);
  const { data: { user } } = await supabase.auth.getUser();
  if (user) {
    isLoggedIn = true;
    const { data: profile } = await supabase.from('profiles').select('role').eq('id', user.id).single();
    userRole = profile?.role || 'student';
  }
} catch {}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <title>{title} | Math Solution Centre</title>
</head>
<body class="min-h-screen">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:p-4 focus:bg-primary-600 focus:text-white focus:rounded-lg">Skip to main content</a>
  <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-xl border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 lg:h-20">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 lg:w-12 lg:h-12 rounded-xl gradient-bg flex items-center justify-center shadow-lg shadow-primary-500/30">
            <span class="text-white font-bold text-lg lg:text-xl">M</span>
          </div>
          <div class="hidden sm:block">
            <span class="font-bold text-lg text-slate-900">Math Solution Centre</span>
            <span class="block text-xs text-slate-500">Mymensingh</span>
          </div>
        </a>

        <div class="hidden lg:flex items-center gap-1">
          <a href="/" class={`btn-ghost ${currentPath === '/' ? 'text-primary-600 font-semibold' : ''}`}>Home</a>
          <a href="/about" class={`btn-ghost ${currentPath === '/about' ? 'text-primary-600 font-semibold' : ''}`}>About</a>
          <a href="/classes" class={`btn-ghost ${currentPath === '/classes' ? 'text-primary-600 font-semibold' : ''}`}>Classes</a>
          <a href="/notice" class={`btn-ghost ${currentPath === '/notice' ? 'text-primary-600 font-semibold' : ''}`}>Notices</a>
          <a href="/gallery" class={`btn-ghost ${currentPath === '/gallery' ? 'text-primary-600 font-semibold' : ''}`}>Gallery</a>
          <a href="/contact" class={`btn-ghost ${currentPath === '/contact' ? 'text-primary-600 font-semibold' : ''}`}>Contact</a>
        </div>

        <div class="flex items-center gap-3">
          {isLoggedIn ? (
            <>
              <a href={userRole === 'admin' ? '/admin/' : '/dashboard/'} class="btn-ghost hidden sm:inline-flex">Dashboard</a>
              <a href="/logout" class="btn-ghost hidden sm:inline-flex">Logout</a>
            </>
          ) : (
            <>
              <a href="/login" class="btn-ghost hidden sm:inline-flex">Login</a>
              <a href="/register" class="btn-ghost hidden sm:inline-flex">Register</a>
            </>
          )}
          <a href="/admission" class="btn-primary text-sm !px-4 !py-2">Enroll Now</a>
        </div>

        <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg hover:bg-slate-100" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-100 bg-white">
      <div class="px-4 py-3 space-y-1">
        <a href="/" class="block px-4 py-2 rounded-lg hover:bg-slate-100">Home</a>
        <a href="/about" class="block px-4 py-2 rounded-lg hover:bg-slate-100">About</a>
        <a href="/classes" class="block px-4 py-2 rounded-lg hover:bg-slate-100">Classes</a>
        <a href="/notice" class="block px-4 py-2 rounded-lg hover:bg-slate-100">Notices</a>
        <a href="/gallery" class="block px-4 py-2 rounded-lg hover:bg-slate-100">Gallery</a>
        <a href="/contact" class="block px-4 py-2 rounded-lg hover:bg-slate-100">Contact</a>
        {isLoggedIn ? (
          <>
            <a href={userRole === 'admin' ? '/admin/' : '/dashboard/'} class="block px-4 py-2 rounded-lg hover:bg-slate-100">Dashboard</a>
            <a href="/logout" class="block px-4 py-2 rounded-lg hover:bg-slate-100">Logout</a>
          </>
        ) : (
          <>
            <a href="/login" class="block px-4 py-2 rounded-lg hover:bg-slate-100">Login</a>
            <a href="/register" class="block px-4 py-2 rounded-lg hover:bg-slate-100">Register</a>
          </>
        )}
      </div>
    </div>
  </nav>

  <main id="main-content" class="pt-16 lg:pt-20">
    <slot />
  </main>

  <footer class="bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center">
              <span class="text-white font-bold text-xl">M</span>
            </div>
            <div>
              <span class="font-bold text-lg">Math Solution Centre</span>
              <span class="block text-sm text-slate-400">Mymensingh</span>
            </div>
          </div>
          <p class="text-slate-400 text-sm leading-relaxed">
            Empowering students with mathematical excellence since 2015. Join us for the best coaching experience in Mymensingh.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-lg mb-4">Quick Links</h3>
          <ul class="space-y-2 text-slate-400">
            <li><a href="/classes" class="hover:text-white transition-colors">Classes</a></li>
            <li><a href="/admission" class="hover:text-white transition-colors">Admission</a></li>
            <li><a href="/notice" class="hover:text-white transition-colors">Notices</a></li>
            <li><a href="/gallery" class="hover:text-white transition-colors">Gallery</a></li>
            <li><a href="/login" class="hover:text-white transition-colors">Login</a></li>
            <li><a href="/register" class="hover:text-white transition-colors">Register</a></li>
          </ul>
        </div>

        <div>
          <h3 class="font-semibold text-lg mb-4">Programs</h3>
          <ul class="space-y-2 text-slate-400">
            <li><a href="/classes#grade-5" class="hover:text-white transition-colors">Grade 5-6</a></li>
            <li><a href="/classes#grade-7" class="hover:text-white transition-colors">Grade 7-8</a></li>
            <li><a href="/classes#grade-9" class="hover:text-white transition-colors">Grade 9-10</a></li>
            <li><a href="/classes#model-test" class="hover:text-white transition-colors">Model Tests</a></li>
          </ul>
        </div>

        <div>
          <h3 class="font-semibold text-lg mb-4">Contact</h3>
          <ul class="space-y-3 text-slate-400">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Station Road, Mymensingh</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>+880 1XXX-XXXXXX</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>info@mathsolutioncentre.com</span>
            </li>
          </ul>
          <div class="flex gap-3 mt-6">
            <a href="https://facebook.com/mathsolutioncentre" target="_blank" rel="noopener" aria-label="Facebook Page" class="w-10 h-10 rounded-lg bg-slate-800 flex items-center justify-center hover:bg-primary-600 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://m.me/mathsolutioncentre" target="_blank" rel="noopener" aria-label="Messenger" class="w-10 h-10 rounded-lg bg-slate-800 flex items-center justify-center hover:bg-primary-600 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24 18.635 24 24.001 18.633 24.001 12.013 24.001 5.393 18.635.026 12.017.026z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 text-center text-slate-500 text-sm">
        &copy; {new Date().getFullYear()} Math Solution & Exam Center Mymensingh. All rights reserved.
      </div>
    </div>
  </footer>

  <button id="back-to-top" class="fixed bottom-6 right-6 z-50 w-12 h-12 rounded-full bg-primary-600 text-white shadow-lg hover:bg-primary-700 transition-all duration-300 opacity-0 pointer-events-none flex items-center justify-center" aria-label="Back to top">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
    </svg>
  </button>

  <script is:inline>
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    menuBtn?.addEventListener('click', () => {
      const isOpen = !mobileMenu?.classList.contains('hidden');
      mobileMenu?.classList.toggle('hidden');
      menuBtn?.setAttribute('aria-expanded', String(!isOpen));
    });

    document.addEventListener('click', (e) => {
      if (!mobileMenu?.classList.contains('hidden') && 
          !mobileMenu?.contains(e.target) && 
          !menuBtn?.contains(e.target)) {
        mobileMenu?.classList.add('hidden');
        menuBtn?.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
        mobileMenu?.classList.add('hidden');
        menuBtn?.setAttribute('aria-expanded', 'false');
      }
    });

    const backToTop = document.getElementById('back-to-top');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        backToTop?.classList.remove('opacity-0', 'pointer-events-none');
        backToTop?.classList.add('opacity-100');
      } else {
        backToTop?.classList.add('opacity-0', 'pointer-events-none');
        backToTop?.classList.remove('opacity-100');
      }
    });
    backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  </script>
</body>
</html>
