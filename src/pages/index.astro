---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout title="Home" description="Math Solution & Exam Center Mymensingh - Your path to mathematical excellence">

  <!-- Hero Section -->
  <section class="relative overflow-hidden gradient-bg min-h-[90vh] flex items-center">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-white/5 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-white/5 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-secondary-500/10 rounded-full blur-3xl"></div>
    </div>

    <div class="absolute inset-0 opacity-[0.03]">
      <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
        <defs>
          <pattern id="hero-grid" width="10" height="10" patternUnits="userSpaceOnUse">
            <path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100" height="100" fill="url(#hero-grid)"/>
      </svg>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="text-white space-y-8">
          <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 text-sm font-medium">
            <span class="w-2 h-2 rounded-full bg-success-500 animate-pulse"></span>
            Admissions Open for 2026
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight">
            Master Mathematics
            <span class="block bg-gradient-to-r from-accent-400 to-secondary-300 bg-clip-text text-transparent">with Confidence</span>
          </h1>
          <p class="text-lg text-white/80 max-w-lg leading-relaxed">
            Join the premier coaching center in Mymensingh. Expert teachers, proven methods, and a track record of excellence for grades 5-10.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/admission" class="inline-flex items-center gap-2 bg-white text-primary-700 px-8 py-4 rounded-xl font-bold hover:bg-slate-50 transition-all duration-200 shadow-xl hover:shadow-2xl hover:-translate-y-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              Start Learning
            </a>
            <a href="/classes" class="inline-flex items-center gap-2 border-2 border-white/30 text-white px-8 py-4 rounded-xl font-bold hover:bg-white/10 transition-all duration-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              View Classes
            </a>
          </div>
        </div>

        <div class="relative hidden lg:flex justify-center">
          <div class="relative w-80 h-80">
            <div class="absolute inset-0 rounded-3xl bg-white/10 backdrop-blur-sm rotate-6 border border-white/20"></div>
            <div class="absolute inset-0 rounded-3xl bg-white/10 backdrop-blur-sm -rotate-3 border border-white/20"></div>
            <div class="relative rounded-3xl bg-white/10 backdrop-blur-xl border border-white/20 p-8 flex flex-col items-center justify-center gap-6">
              <svg class="w-20 h-20 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
              <div class="text-center text-white">
                <div class="text-3xl font-bold">500+</div>
                <div class="text-white/70">Students Trust Us</div>
              </div>
              <div class="grid grid-cols-2 gap-3 w-full">
                <div class="bg-white/10 rounded-xl p-3 text-center">
                  <div class="text-white font-bold">95%</div>
                  <div class="text-white/60 text-xs">Success</div>
                </div>
                <div class="bg-white/10 rounded-xl p-3 text-center">
                  <div class="text-white font-bold">15+</div>
                  <div class="text-white/60 text-xs">Teachers</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-20 bg-gradient-to-t from-slate-50 to-transparent"></div>
  </section>

  <!-- Stats Section -->
  <section class="section-padding -mt-10 relative z-10">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="card-glass p-6 text-center group hover:-translate-y-1 transition-transform duration-300">
          <div class="w-14 h-14 rounded-2xl gradient-bg flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </div>
          <div class="text-3xl lg:text-4xl font-extrabold gradient-text">500+</div>
          <div class="text-slate-500 font-medium mt-1">Students</div>
        </div>
        <div class="card-glass p-6 text-center group hover:-translate-y-1 transition-transform duration-300">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-secondary-500 to-secondary-700 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <div class="text-3xl lg:text-4xl font-extrabold gradient-text">15+</div>
          <div class="text-slate-500 font-medium mt-1">Teachers</div>
        </div>
        <div class="card-glass p-6 text-center group hover:-translate-y-1 transition-transform duration-300">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-success-500 to-emerald-600 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div class="text-3xl lg:text-4xl font-extrabold gradient-text">95%</div>
          <div class="text-slate-500 font-medium mt-1">Success Rate</div>
        </div>
        <div class="card-glass p-6 text-center group hover:-translate-y-1 transition-transform duration-300">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div class="text-3xl lg:text-4xl font-extrabold gradient-text">8+</div>
          <div class="text-slate-500 font-medium mt-1">Years</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="inline-block text-primary-600 font-semibold text-sm uppercase tracking-wider mb-3">Why Choose Us</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">
          Everything You Need to <span class="gradient-text">Excel</span>
        </h2>
        <p class="text-slate-500 mt-4 text-lg">Comprehensive tools and resources designed for academic success</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="card p-8 group hover:-translate-y-1">
          <div class="w-14 h-14 rounded-2xl gradient-bg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-lg shadow-primary-500/25">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Expert Teachers</h3>
          <p class="text-slate-500 leading-relaxed">Learn from experienced educators who are passionate about making math accessible and enjoyable.</p>
        </div>

        <div class="card p-8 group hover:-translate-y-1">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-secondary-500 to-secondary-700 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-lg shadow-secondary-500/25">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Online Exams</h3>
          <p class="text-slate-500 leading-relaxed">Take practice exams online and get instant feedback to track your progress effectively.</p>
        </div>

        <div class="card p-8 group hover:-translate-y-1">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-accent-500 to-cyan-600 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-lg shadow-accent-500/25">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Study Materials</h3>
          <p class="text-slate-500 leading-relaxed">Access comprehensive study materials, notes, and practice problems curated by experts.</p>
        </div>

        <div class="card p-8 group hover:-translate-y-1">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-success-500 to-emerald-600 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-lg shadow-success-500/25">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Results Tracking</h3>
          <p class="text-slate-500 leading-relaxed">Monitor performance with detailed analytics and personalized improvement suggestions.</p>
        </div>

        <div class="card p-8 group hover:-translate-y-1">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-lg shadow-amber-500/25">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Class Routines</h3>
          <p class="text-slate-500 leading-relaxed">Stay organized with clear schedules and never miss a class or important deadline.</p>
        </div>

        <div class="card p-8 group hover:-translate-y-1">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-pink-500 to-rose-600 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-lg shadow-pink-500/25">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Modern Learning</h3>
          <p class="text-slate-500 leading-relaxed">Experience interactive lessons with modern teaching tools and technology-driven education.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Classes Preview -->
  <section class="section-padding bg-slate-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="inline-block text-primary-600 font-semibold text-sm uppercase tracking-wider mb-3">Our Programs</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">
          Classes for <span class="gradient-text">Every Grade</span>
        </h2>
        <p class="text-slate-500 mt-4 text-lg">Structured curriculum designed for students from grade 5 to 10</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
        <a href="/classes#grade-5" class="card p-6 text-center group hover:-translate-y-2 hover:shadow-xl transition-all duration-300">
          <div class="w-16 h-16 rounded-2xl gradient-bg flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-lg shadow-primary-500/25">
            <span class="text-white font-extrabold text-2xl">5</span>
          </div>
          <h3 class="font-bold text-slate-900">Grade 5</h3>
          <p class="text-sm text-slate-500 mt-1">Foundation Building</p>
        </a>

        <a href="/classes#grade-6" class="card p-6 text-center group hover:-translate-y-2 hover:shadow-xl transition-all duration-300">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-secondary-500 to-secondary-700 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-lg shadow-secondary-500/25">
            <span class="text-white font-extrabold text-2xl">6</span>
          </div>
          <h3 class="font-bold text-slate-900">Grade 6</h3>
          <p class="text-sm text-slate-500 mt-1">Core Concepts</p>
        </a>

        <a href="/classes#grade-7" class="card p-6 text-center group hover:-translate-y-2 hover:shadow-xl transition-all duration-300">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-accent-500 to-cyan-600 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-lg shadow-accent-500/25">
            <span class="text-white font-extrabold text-2xl">7</span>
          </div>
          <h3 class="font-bold text-slate-900">Grade 7</h3>
          <p class="text-sm text-slate-500 mt-1">Skill Development</p>
        </a>

        <a href="/classes#grade-8" class="card p-6 text-center group hover:-translate-y-2 hover:shadow-xl transition-all duration-300">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-success-500 to-emerald-600 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-lg shadow-success-500/25">
            <span class="text-white font-extrabold text-2xl">8</span>
          </div>
          <h3 class="font-bold text-slate-900">Grade 8</h3>
          <p class="text-sm text-slate-500 mt-1">Advanced Topics</p>
        </a>

        <a href="/classes#grade-9" class="card p-6 text-center group hover:-translate-y-2 hover:shadow-xl transition-all duration-300">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-lg shadow-amber-500/25">
            <span class="text-white font-extrabold text-2xl">9</span>
          </div>
          <h3 class="font-bold text-slate-900">Grade 9</h3>
          <p class="text-sm text-slate-500 mt-1">Exam Preparation</p>
        </a>

        <a href="/classes#grade-10" class="card p-6 text-center group hover:-translate-y-2 hover:shadow-xl transition-all duration-300">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-pink-500 to-rose-600 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-lg shadow-pink-500/25">
            <span class="text-white font-extrabold text-2xl">10</span>
          </div>
          <h3 class="font-bold text-slate-900">Grade 10</h3>
          <p class="text-sm text-slate-500 mt-1">Final Success</p>
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="inline-block text-primary-600 font-semibold text-sm uppercase tracking-wider mb-3">Get Started</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">
          How It <span class="gradient-text">Works</span>
        </h2>
        <p class="text-slate-500 mt-4 text-lg">Three simple steps to begin your mathematical journey</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 relative">
        <div class="hidden md:block absolute top-24 left-1/6 right-1/6 h-0.5 bg-gradient-to-r from-primary-200 via-secondary-200 to-primary-200"></div>

        <div class="relative text-center">
          <div class="w-20 h-20 rounded-full gradient-bg flex items-center justify-center mx-auto mb-6 shadow-xl shadow-primary-500/30 relative z-10">
            <span class="text-white font-extrabold text-2xl">1</span>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Enroll</h3>
          <p class="text-slate-500 leading-relaxed">Register for your grade and get access to all resources and classes immediately.</p>
        </div>

        <div class="relative text-center">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-secondary-500 to-secondary-700 flex items-center justify-center mx-auto mb-6 shadow-xl shadow-secondary-500/30 relative z-10">
            <span class="text-white font-extrabold text-2xl">2</span>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Learn</h3>
          <p class="text-slate-500 leading-relaxed">Attend expert-led classes, solve practice problems, and take online exams.</p>
        </div>

        <div class="relative text-center">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-success-500 to-emerald-600 flex items-center justify-center mx-auto mb-6 shadow-xl shadow-success-500/30 relative z-10">
            <span class="text-white font-extrabold text-2xl">3</span>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Succeed</h3>
          <p class="text-slate-500 leading-relaxed">Achieve excellent results and build a strong mathematical foundation for life.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding gradient-bg relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute -top-20 -right-20 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-4xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-6">Ready to Excel in Mathematics?</h2>
      <p class="text-lg text-white/80 mb-10 max-w-2xl mx-auto">
        Join hundreds of successful students. Start your journey with Math Solution Centre today and unlock your full potential.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/admission" class="inline-flex items-center gap-2 bg-white text-primary-700 px-10 py-4 rounded-xl font-bold text-lg hover:bg-slate-50 transition-all duration-200 shadow-xl hover:shadow-2xl hover:-translate-y-0.5">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          Enroll Now
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 border-2 border-white/30 text-white px-10 py-4 rounded-xl font-bold text-lg hover:bg-white/10 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Contact Us
        </a>
      </div>
    </div>
  </section>

</PublicLayout>
