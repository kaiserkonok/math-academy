---
import PublicLayout from '../layouts/PublicLayout.astro';
---
<PublicLayout title="Page Not Found">
  <section class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-6xl font-extrabold text-slate-200 mb-4">404</h1>
      <p class="text-xl text-slate-600 mb-8">The page you're looking for doesn't exist.</p>
      <a href="/" class="btn-primary">Go Home</a>
    </div>
  </section>
</PublicLayout>
