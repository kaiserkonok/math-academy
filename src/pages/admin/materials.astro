---
import AdminLayout from '../../layouts/AdminLayout.astro';

const materials = [
  { id: 'MAT-001', title: 'Algebra - Linear Equations Notes', grade: 8, chapter: 'Chapter 3', type: 'Notes', fileSize: '2.4 MB', uploadDate: '2026-09-12', description: 'Complete notes covering linear equations, variables, and solving methods with practice examples.' },
  { id: 'MAT-002', title: 'Geometry - Triangles MCQ Bank', grade: 7, chapter: 'Chapter 5', type: 'MCQ', fileSize: '850 KB', uploadDate: '2026-09-10', description: '50 multiple choice questions on triangle properties, congruence, and similarity.' },
  { id: 'MAT-003', title: 'Number Theory Comprehensive PDF', grade: 6, chapter: 'Chapter 1', type: 'PDF', fileSize: '5.1 MB', uploadDate: '2026-09-08', description: 'Comprehensive PDF covering prime numbers, factors, multiples, and divisibility rules.' },
  { id: 'MAT-004', title: 'Algebra Model Exam Paper', grade: 8, chapter: 'Chapter 3', type: 'Model', fileSize: '1.2 MB', uploadDate: '2026-09-06', description: 'Model exam paper with 100 marks covering algebra fundamentals and advanced problems.' },
  { id: 'MAT-005', title: 'Fractions & Decimals Notes', grade: 5, chapter: 'Chapter 2', type: 'Notes', fileSize: '1.8 MB', uploadDate: '2026-09-04', description: 'Easy-to-understand notes on fractions, decimals, and their conversions with examples.' },
  { id: 'MAT-006', title: 'Trigonometry MCQ Collection', grade: 10, chapter: 'Chapter 4', type: 'MCQ', fileSize: '1.1 MB', uploadDate: '2026-09-02', description: '100 MCQs on trigonometric ratios, identities, and applications.' },
  { id: 'MAT-007', title: 'Statistics & Probability PDF', grade: 9, chapter: 'Chapter 6', type: 'PDF', fileSize: '3.7 MB', uploadDate: '2026-08-30', description: 'Detailed PDF on mean, median, mode, probability, and data representation.' },
  { id: 'MAT-008', title: 'Geometry Model Exam Paper', grade: 7, chapter: 'Chapter 5', type: 'Model', fileSize: '980 KB', uploadDate: '2026-08-28', description: 'Full-length model exam on geometry topics including circles and angles.' },
  { id: 'MAT-009', title: 'Arithmetic Operations Notes', grade: 5, chapter: 'Chapter 1', type: 'Notes', fileSize: '2.0 MB', uploadDate: '2026-08-25', description: 'Foundation notes on addition, subtraction, multiplication, and division strategies.' },
  { id: 'MAT-010', title: 'Quadratic Equations MCQ', grade: 10, chapter: 'Chapter 2', type: 'MCQ', fileSize: '720 KB', uploadDate: '2026-08-22', description: 'Test your knowledge on quadratic equations, formulas, and graphical solutions.' },
];

const totalMaterials = materials.length;
const notesCount = materials.filter(m => m.type === 'Notes').length;
const mcqCount = materials.filter(m => m.type === 'MCQ').length;
const pdfCount = materials.filter(m => m.type === 'PDF').length;

const typeBadgeClasses: Record<string, string> = {
  Notes: 'bg-blue-100 text-blue-700',
  MCQ: 'bg-purple-100 text-purple-700',
  PDF: 'bg-red-100 text-red-700',
  Model: 'bg-emerald-100 text-emerald-700',
};
---

<AdminLayout title="Study Materials">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Study Materials</h1>
      <p class="text-slate-500 mt-1">Manage study materials for Math Solution & Exam Center Mymensingh</p>
    </div>
    <button
      onclick="openModal()"
      class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-primary-600 to-primary-700 text-white rounded-xl font-semibold shadow-lg shadow-primary-600/25 hover:shadow-xl hover:shadow-primary-600/30 transition-all duration-200"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
      </svg>
      Upload Material
    </button>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">Total Materials</p>
          <p class="text-2xl font-bold text-slate-900">{totalMaterials}</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">Notes</p>
          <p class="text-2xl font-bold text-slate-900">{notesCount}</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">MCQs</p>
          <p class="text-2xl font-bold text-slate-900">{mcqCount}</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">PDFs</p>
          <p class="text-2xl font-bold text-slate-900">{pdfCount}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Materials Table -->
  <div class="card">
    <!-- Filters -->
    <div class="p-5 border-b border-slate-100">
      <div class="flex flex-col lg:flex-row gap-4">
        <div class="flex-1 relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            placeholder="Search materials by title, chapter..."
            class="input-field pl-10"
            id="searchInput"
            oninput="filterMaterials()"
          />
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <select class="input-field w-full sm:w-36" id="gradeFilter" onchange="filterMaterials()">
            <option value="">All Grades</option>
            <option value="5">Grade 5</option>
            <option value="6">Grade 6</option>
            <option value="7">Grade 7</option>
            <option value="8">Grade 8</option>
            <option value="9">Grade 9</option>
            <option value="10">Grade 10</option>
          </select>
          <select class="input-field w-full sm:w-36" id="typeFilter" onchange="filterMaterials()">
            <option value="">All Types</option>
            <option value="Notes">Notes</option>
            <option value="MCQ">MCQ</option>
            <option value="PDF">PDF</option>
            <option value="Model">Model</option>
          </select>
          <select class="input-field w-full sm:w-40" id="chapterFilter" onchange="filterMaterials()">
            <option value="">All Chapters</option>
            <option value="Chapter 1">Chapter 1</option>
            <option value="Chapter 2">Chapter 2</option>
            <option value="Chapter 3">Chapter 3</option>
            <option value="Chapter 4">Chapter 4</option>
            <option value="Chapter 5">Chapter 5</option>
            <option value="Chapter 6">Chapter 6</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100">
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Title</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Grade</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Chapter</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Type</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">File Size</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Upload Date</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody id="materialsTableBody" class="divide-y divide-slate-100">
          {materials.map((material) => (
            <tr class="hover:bg-slate-50 transition-colors" data-id={material.id} data-grade={material.grade} data-type={material.type} data-chapter={material.chapter}>
              <td class="px-5 py-4">
                <div class="flex items-center gap-3">
                  <div class={`w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 ${
                    material.type === 'Notes' ? 'bg-blue-50' :
                    material.type === 'MCQ' ? 'bg-purple-50' :
                    material.type === 'PDF' ? 'bg-red-50' : 'bg-emerald-50'
                  }`}>
                    {material.type === 'Notes' && (
                      <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    )}
                    {material.type === 'MCQ' && (
                      <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                      </svg>
                    )}
                    {material.type === 'PDF' && (
                      <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                      </svg>
                    )}
                    {material.type === 'Model' && (
                      <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                      </svg>
                    )}
                  </div>
                  <div>
                    <p class="font-medium text-slate-900">{material.title}</p>
                    <p class="text-xs text-slate-500 mt-0.5 line-clamp-1">{material.description}</p>
                  </div>
                </div>
              </td>
              <td class="px-5 py-4">
                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-secondary-100 text-secondary-700">
                  Grade {material.grade}
                </span>
              </td>
              <td class="px-5 py-4 text-sm text-slate-600">{material.chapter}</td>
              <td class="px-5 py-4">
                <span class={`inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold ${typeBadgeClasses[material.type]}`}>
                  {material.type}
                </span>
              </td>
              <td class="px-5 py-4 text-sm text-slate-600">{material.fileSize}</td>
              <td class="px-5 py-4 text-sm text-slate-600">{material.uploadDate}</td>
              <td class="px-5 py-4">
                <div class="flex items-center gap-1">
                  <button title="Edit" onclick={`editMaterial('${material.id}', '${material.title.replace(/'/g, "\\'")}', '${material.grade}', '${material.chapter.replace(/'/g, "\\'")}', '${material.type}', '${material.description.replace(/'/g, "\\'")}')`} class="p-2 text-slate-400 hover:text-secondary-600 hover:bg-secondary-50 rounded-lg transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  </button>
                  <a title="Download" href={`/materials/${material.id}.pdf`} download class="p-2 text-slate-400 hover:text-primary-600 hover:bg-primary-50 rounded-lg transition-colors inline-flex">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                  </a>
                  <button title="Delete" onclick={`deleteMaterial('${material.id}')`} class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="p-5 border-t border-slate-100">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-slate-500">Showing <span class="font-semibold text-slate-700">1-{totalMaterials}</span> of <span class="font-semibold text-slate-700">{totalMaterials}</span> materials</p>
        <div class="flex items-center gap-1">
          <button class="px-3 py-2 text-sm font-medium text-slate-400 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button class="px-3 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">1</button>
          <button class="px-3 py-2 text-sm font-medium text-slate-400 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Upload/Edit Material Modal -->
  <div id="materialModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg mx-4">
      <div class="card p-0 overflow-hidden animate-in">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
          <h3 id="modalTitle" class="text-lg font-bold text-slate-900">Upload New Material</h3>
          <button onclick="closeModal()" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form id="materialForm" onsubmit="handleSubmit(event)" class="p-6 space-y-4">
          <input type="hidden" id="formAction" value="add" />
          <input type="hidden" id="editMaterialId" value="" />
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Title</label>
            <input type="text" id="materialTitle" required class="input-field" placeholder="e.g. Algebra - Linear Equations Notes" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Grade</label>
              <select id="materialGrade" required class="input-field">
                <option value="">Select Grade</option>
                <option value="5">Grade 5</option>
                <option value="6">Grade 6</option>
                <option value="7">Grade 7</option>
                <option value="8">Grade 8</option>
                <option value="9">Grade 9</option>
                <option value="10">Grade 10</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Chapter</label>
              <select id="materialChapter" required class="input-field">
                <option value="">Select Chapter</option>
                <option value="Chapter 1">Chapter 1</option>
                <option value="Chapter 2">Chapter 2</option>
                <option value="Chapter 3">Chapter 3</option>
                <option value="Chapter 4">Chapter 4</option>
                <option value="Chapter 5">Chapter 5</option>
                <option value="Chapter 6">Chapter 6</option>
                <option value="Chapter 7">Chapter 7</option>
                <option value="Chapter 8">Chapter 8</option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Material Type</label>
            <select id="materialType" required class="input-field">
              <option value="">Select Type</option>
              <option value="Notes">Notes</option>
              <option value="MCQ">MCQ</option>
              <option value="PDF">PDF</option>
              <option value="Model">Model</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">File Upload</label>
            <div class="relative">
              <input type="file" id="materialFile" class="hidden" onchange="handleFileChange()" />
              <button type="button" onclick="document.getElementById('materialFile').click()" id="fileDropZone" class="w-full flex flex-col items-center gap-2 px-4 py-8 border-2 border-dashed border-slate-200 rounded-xl text-slate-500 hover:border-primary-400 hover:text-primary-600 transition-colors">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
                <span class="text-sm font-medium">Drag & drop or click to upload</span>
                <span class="text-xs text-slate-400">PDF, DOC, PPT up to 50MB</span>
              </button>
              <div id="filePreview" class="hidden mt-2 flex items-center gap-2 p-2 bg-green-50 rounded-lg">
                <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                </svg>
                <span id="fileName" class="text-sm text-green-700 font-medium"></span>
                <button type="button" onclick="removeFile()" class="ml-auto text-green-600 hover:text-red-600 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Description</label>
            <textarea id="materialDescription" rows="3" class="input-field" placeholder="Brief description of the material..."></textarea>
          </div>
          <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
            <button type="button" onclick="closeModal()" class="px-5 py-2.5 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
              Cancel
            </button>
            <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-gradient-to-r from-primary-600 to-primary-700 rounded-xl shadow-lg shadow-primary-600/25 hover:shadow-xl hover:shadow-primary-600/30 transition-all duration-200">
              Upload Material
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="deleteModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeDeleteModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md mx-4">
      <div class="card p-0 overflow-hidden animate-in">
        <div class="p-6 text-center">
          <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-red-100 flex items-center justify-center">
            <svg class="w-7 h-7 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Delete Material</h3>
          <p class="text-sm text-slate-500 mb-6">Are you sure you want to delete this material? This action cannot be undone.</p>
          <div class="flex items-center justify-center gap-3">
            <button onclick="closeDeleteModal()" class="px-5 py-2.5 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
              Cancel
            </button>
            <button onclick="confirmDelete()" class="px-5 py-2.5 text-sm font-medium text-white bg-red-600 rounded-xl hover:bg-red-700 transition-colors">
              Delete
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    @keyframes animate-in {
      from { opacity: 0; transform: translate(-50%, -50%) scale(0.95); }
      to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    }
    .animate-in {
      animation: animate-in 0.2s ease-out;
    }
  </style>

  <script is:inline>
    let deleteTargetId = '';

    function openModal() {
      document.getElementById('formAction').value = 'add';
      document.getElementById('editMaterialId').value = '';
      document.getElementById('modalTitle').textContent = 'Upload New Material';
      document.getElementById('materialForm').reset();
      removeFile();
      document.getElementById('materialModal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('materialModal').classList.add('hidden');
    }

    function editMaterial(id, title, grade, chapter, type, description) {
      document.getElementById('formAction').value = 'edit';
      document.getElementById('editMaterialId').value = id;
      document.getElementById('modalTitle').textContent = 'Edit Material';
      document.getElementById('materialTitle').value = title;
      document.getElementById('materialGrade').value = grade;
      document.getElementById('materialChapter').value = chapter;
      document.getElementById('materialType').value = type;
      document.getElementById('materialDescription').value = description;
      document.getElementById('materialModal').classList.remove('hidden');
    }

    function handleFileChange() {
      const input = document.getElementById('materialFile');
      if (input.files && input.files.length > 0) {
        const file = input.files[0];
        document.getElementById('fileName').textContent = file.name;
        document.getElementById('filePreview').classList.remove('hidden');
        document.getElementById('fileDropZone').classList.add('hidden');
      }
    }

    function removeFile() {
      const input = document.getElementById('materialFile');
      input.value = '';
      document.getElementById('filePreview').classList.add('hidden');
      document.getElementById('fileDropZone').classList.remove('hidden');
    }

    function handleSubmit(e) {
      e.preventDefault();
      const action = document.getElementById('formAction').value;
      if (action === 'add') {
        alert('Material uploaded successfully!');
      } else {
        alert('Material updated successfully!');
      }
      closeModal();
    }

    function deleteMaterial(id) {
      deleteTargetId = id;
      document.getElementById('deleteModal').classList.remove('hidden');
    }

    function closeDeleteModal() {
      document.getElementById('deleteModal').classList.add('hidden');
      deleteTargetId = '';
    }

    function confirmDelete() {
      if (deleteTargetId) {
        alert('Material deleted successfully!');
      }
      closeDeleteModal();
    }

    function filterMaterials() {
      const search = document.getElementById('searchInput').value.toLowerCase();
      const grade = document.getElementById('gradeFilter').value;
      const type = document.getElementById('typeFilter').value;
      const chapter = document.getElementById('chapterFilter').value;
      const rows = document.querySelectorAll('#materialsTableBody tr');
      rows.forEach(row => {
        const el = row;
        const title = el.querySelector('td:nth-child(1)')?.textContent?.toLowerCase() || '';
        const rowGrade = el.dataset.grade || '';
        const rowType = el.dataset.type || '';
        const rowChapter = el.dataset.chapter || '';
        const matchSearch = !search || title.includes(search);
        const matchGrade = !grade || rowGrade === grade;
        const matchType = !type || rowType === type;
        const matchChapter = !chapter || rowChapter === chapter;
        el.style.display = matchSearch && matchGrade && matchType && matchChapter ? '' : 'none';
      });
    }

    const dropZone = document.getElementById('fileDropZone');
    if (dropZone) {
      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('border-primary-400', 'bg-primary-50');
      });
      dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('border-primary-400', 'bg-primary-50');
      });
      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-primary-400', 'bg-primary-50');
        const files = e.dataTransfer?.files;
        if (files && files.length > 0) {
          const input = document.getElementById('materialFile');
          const dataTransfer = new DataTransfer();
          dataTransfer.items.add(files[0]);
          input.files = dataTransfer.files;
          handleFileChange();
        }
      });
    }
  </script>
</AdminLayout>