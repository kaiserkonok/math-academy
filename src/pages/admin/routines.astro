---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createClient } from '../../lib/supabase-server';
const { supabase } = createClient(Astro.request, Astro.cookies);

const { data: routinesData } = await supabase
  .from('routines')
  .select('*')
  .order('date', { ascending: true });

const routines = (routinesData || []).map(r => ({
  id: `RUT-${String(r.id).padStart(3, '0')}`,
  title: r.title || 'Untitled',
  grade: r.grade || 'N/A',
  chapter: r.chapter || 'N/A',
  type: r.routine_type || 'Class',
  date: r.date || 'N/A',
  startTime: r.start_time || '00:00',
  endTime: r.end_time || '00:00',
  description: r.description || '',
}));

const classRoutines = routines.filter(r => r.type === 'Class');
const examRoutines = routines.filter(r => r.type === 'Exam');

const weekDays = ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'];
const gradeColors: Record<string, string> = {
  'Class 9': 'bg-blue-100 text-blue-700 border-blue-200',
  'Class 10': 'bg-purple-100 text-purple-700 border-purple-200',
};
const typeColors: Record<string, string> = {
  'Class': 'bg-primary-100 text-primary-700',
  'Exam': 'bg-red-100 text-red-700',
};
---

<AdminLayout title="Routine Management">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Routine Management</h1>
      <p class="text-slate-500 mt-1">Manage class and exam routines for Math Solution & Exam Center Mymensingh</p>
    </div>
    <button
      onclick="openModal()"
      class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-primary-600 to-primary-700 text-white rounded-xl font-semibold shadow-lg shadow-primary-600/25 hover:shadow-xl hover:shadow-primary-600/30 transition-all duration-200"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Add Routine
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">Total Routines</p>
          <p class="text-2xl font-bold text-slate-900">{routines.length}</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">Class Routines</p>
          <p class="text-2xl font-bold text-slate-900">{classRoutines.length}</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">Exam Routines</p>
          <p class="text-2xl font-bold text-slate-900">{examRoutines.length}</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">This Week</p>
          <p class="text-2xl font-bold text-slate-900">{routines.length}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-6">
    <div class="border-b border-slate-100">
      <nav class="flex gap-0">
        <button onclick="switchTab('table')" id="tab-table" class="tab-btn active px-6 py-4 text-sm font-semibold border-b-2 transition-all duration-200">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            Table View
          </span>
        </button>
        <button onclick="switchTab('weekly')" id="tab-weekly" class="tab-btn px-6 py-4 text-sm font-semibold border-b-2 transition-all duration-200">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Weekly View
          </span>
        </button>
      </nav>
    </div>

    <div id="view-table">
      <div class="p-5 border-b border-slate-100">
        <div class="flex flex-col lg:flex-row gap-4">
          <div class="flex-1 relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" placeholder="Search routines..." class="input-field pl-10" id="searchInput" oninput="filterRoutines()" />
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <select class="input-field w-full sm:w-40" id="gradeFilter" onchange="filterRoutines()">
              <option value="">All Grades</option>
              <option value="Class 9">Class 9</option>
              <option value="Class 10">Class 10</option>
            </select>
            <select class="input-field w-full sm:w-40" id="typeFilter" onchange="filterRoutines()">
              <option value="">All Types</option>
              <option value="Class">Class</option>
              <option value="Exam">Exam</option>
            </select>
          </div>
        </div>
      </div>

      {routines.length === 0 ? (
        <div class="text-center py-16">
          <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="text-slate-500 font-medium">No routines found</p>
          <p class="text-sm text-slate-400 mt-1">Add routines to schedule classes and exams.</p>
        </div>
      ) : (
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-100">
              <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Title</th>
              <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Grade</th>
              <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Chapter</th>
              <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Type</th>
              <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Date</th>
              <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Start Time</th>
              <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">End Time</th>
              <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody id="routinesTableBody" class="divide-y divide-slate-100">
            {routines.map((routine) => (
              <tr class="hover:bg-slate-50 transition-colors" data-id={routine.id} data-grade={routine.grade} data-type={routine.type}>
                <td class="px-5 py-4">
                  <div>
                    <p class="font-medium text-slate-900">{routine.title}</p>
                    <p class="text-xs text-slate-400 mt-0.5">{routine.description}</p>
                  </div>
                </td>
                <td class="px-5 py-4">
                  <span class={`inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold ${gradeColors[routine.grade] || 'bg-slate-100 text-slate-700'}`}>
                    {routine.grade}
                  </span>
                </td>
                <td class="px-5 py-4 text-sm text-slate-600">{routine.chapter}</td>
                <td class="px-5 py-4">
                  <span class={`inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold ${typeColors[routine.type] || 'bg-slate-100 text-slate-700'}`}>
                    {routine.type}
                  </span>
                </td>
                <td class="px-5 py-4 text-sm text-slate-600">{routine.date}</td>
                <td class="px-5 py-4 text-sm text-slate-600">{routine.startTime}</td>
                <td class="px-5 py-4 text-sm text-slate-600">{routine.endTime}</td>
                <td class="px-5 py-4">
                  <div class="flex items-center gap-1">
                    <button title="Edit" class="p-2 text-slate-400 hover:text-secondary-600 hover:bg-secondary-50 rounded-lg transition-colors">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </button>
                    <button title="Delete" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      )}

      <div class="p-5 border-t border-slate-100">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-sm text-slate-500">Showing <span class="font-semibold text-slate-700">1-{routines.length}</span> of <span class="font-semibold text-slate-700">{routines.length}</span> routines</p>
        </div>
      </div>
    </div>

    <div id="view-weekly" class="hidden p-5">
      <div class="grid grid-cols-1 md:grid-cols-7 gap-3">
        {weekDays.map((day) => {
          const dayRoutines = routines.filter(r => {
            const d = new Date(r.date);
            const dayOfWeek = d.getDay();
            const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
            return dayNames[dayOfWeek] === day;
          });
          const isToday = day === 'Monday';
          return (
            <div class={`rounded-xl border-2 transition-all duration-200 ${isToday ? 'border-primary-300 bg-primary-50/50' : 'border-slate-200 bg-white'}`}>
              <div class={`px-3 py-2.5 border-b ${isToday ? 'border-primary-200 bg-primary-100/50' : 'border-slate-100 bg-slate-50'}`}>
                <h4 class={`text-xs font-bold uppercase tracking-wider ${isToday ? 'text-primary-700' : 'text-slate-500'}`}>{day}</h4>
                {isToday && <span class="text-[10px] font-medium text-primary-600">Today</span>}
              </div>
              <div class="p-2 space-y-2 min-h-[120px]">
                {dayRoutines.length === 0 ? (
                  <p class="text-xs text-slate-400 text-center py-4">No routines</p>
                ) : (
                  dayRoutines.map((routine) => (
                    <div class={`p-2 rounded-lg border text-xs cursor-pointer hover:shadow-md transition-shadow ${gradeColors[routine.grade] || 'bg-slate-100 text-slate-700 border-slate-200'}`}>
                      <p class="font-semibold truncate">{routine.title.split(' - ')[0]}</p>
                      <p class="opacity-75 mt-0.5">{routine.startTime} - {routine.endTime}</p>
                      <span class={`inline-block mt-1 px-1.5 py-0.5 rounded text-[10px] font-bold ${typeColors[routine.type]}`}>
                        {routine.type}
                      </span>
                    </div>
                  ))
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <div id="routineModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg mx-4">
      <div class="card p-0 overflow-hidden animate-in">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
          <h3 id="modalTitle" class="text-lg font-bold text-slate-900">Add New Routine</h3>
          <button onclick="closeModal()" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form id="routineForm" onsubmit="handleSubmit(event)" class="p-6 space-y-4">
          <input type="hidden" id="formAction" value="add" />
          <input type="hidden" id="editRoutineId" value="" />
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Title</label>
            <input type="text" id="routineTitle" required class="input-field" placeholder="e.g. Class 9 Algebra - Chapter 3" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Grade</label>
              <select id="routineGrade" required class="input-field">
                <option value="">Select Grade</option>
                <option value="Class 9">Class 9</option>
                <option value="Class 10">Class 10</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Chapter</label>
              <input type="text" id="routineChapter" required class="input-field" placeholder="e.g. Algebra" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Routine Type</label>
            <select id="routineType" required class="input-field">
              <option value="">Select Type</option>
              <option value="Class">Class</option>
              <option value="Exam">Exam</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Date</label>
            <input type="date" id="routineDate" required class="input-field" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Start Time</label>
              <input type="time" id="routineStartTime" required class="input-field" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">End Time</label>
              <input type="time" id="routineEndTime" required class="input-field" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Description</label>
            <textarea id="routineDescription" rows="3" class="input-field" placeholder="Optional description..."></textarea>
          </div>
          <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
            <button type="button" onclick="closeModal()" class="px-5 py-2.5 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
              Cancel
            </button>
            <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-gradient-to-r from-primary-600 to-primary-700 rounded-xl shadow-lg shadow-primary-600/25 hover:shadow-xl hover:shadow-primary-600/30 transition-all duration-200">
              Save Routine
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <style>
    @keyframes animate-in {
      from { opacity: 0; transform: translate(-50%, -50%) scale(0.95); }
      to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    }
    .animate-in {
      animation: animate-in 0.2s ease-out;
    }
    .tab-btn {
      color: #94a3b8;
      border-color: transparent;
    }
    .tab-btn.active {
      color: #4f46e5;
      border-color: #4f46e5;
    }
  </style>

  <script is:inline>
    function switchTab(tab) {
      document.getElementById('view-table')?.classList.toggle('hidden', tab !== 'table');
      document.getElementById('view-weekly')?.classList.toggle('hidden', tab !== 'weekly');
      document.getElementById('tab-table')?.classList.toggle('active', tab === 'table');
      document.getElementById('tab-weekly')?.classList.toggle('active', tab === 'weekly');
    }

    function openModal() {
      document.getElementById('formAction').value = 'add';
      document.getElementById('editRoutineId').value = '';
      document.getElementById('modalTitle').textContent = 'Add New Routine';
      document.getElementById('routineForm').reset();
      document.getElementById('routineModal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('routineModal').classList.add('hidden');
    }

    function handleSubmit(e) {
      e.preventDefault();
      const action = document.getElementById('formAction').value;
      if (action === 'add') {
        alert('Routine added successfully!');
      } else {
        alert('Routine updated successfully!');
      }
      closeModal();
    }

    function deleteRoutine(id) {
      if (confirm('Are you sure you want to delete this routine?')) {
        alert('Routine deleted successfully!');
      }
    }

    function filterRoutines() {
      const search = document.getElementById('searchInput').value.toLowerCase();
      const grade = document.getElementById('gradeFilter').value;
      const type = document.getElementById('typeFilter').value;
      const rows = document.querySelectorAll('#routinesTableBody tr');
      rows.forEach(row => {
        const el = row;
        const title = el.querySelector('td:nth-child(1)')?.textContent?.toLowerCase() || '';
        const rowGrade = el.dataset.grade || '';
        const rowType = el.dataset.type || '';
        const matchSearch = !search || title.includes(search);
        const matchGrade = !grade || rowGrade === grade;
        const matchType = !type || rowType === type;
        el.style.display = matchSearch && matchGrade && matchType ? '' : 'none';
      });
    }
  </script>
</AdminLayout>
