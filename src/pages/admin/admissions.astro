---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createClient } from '../../lib/supabase-server';
const { supabase } = createClient(Astro.request, Astro.cookies);

const { data: admissionsData } = await supabase
  .from('admissions')
  .select('id, student_name, grade, phone, parent_name, parent_phone, address, status, applied_at')
  .order('applied_at', { ascending: false });

const admissions = (admissionsData || []).map(a => ({
  id: `ADM-${String(a.id).padStart(3, '0')}`,
  name: a.student_name || 'Unknown',
  grade: a.grade || 0,
  phone: a.phone || 'N/A',
  parentName: a.parent_name || 'N/A',
  parentPhone: a.parent_phone || 'N/A',
  address: a.address || 'N/A',
  status: a.status || 'pending',
  appliedDate: a.applied_at ? new Date(a.applied_at).toISOString().split('T')[0] : 'N/A',
}));

const totalApplications = admissions.length;
const pendingCount = admissions.filter(a => a.status === 'pending').length;
const approvedCount = admissions.filter(a => a.status === 'approved').length;
const rejectedCount = admissions.filter(a => a.status === 'rejected').length;
---

<AdminLayout title="Admission Management">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Admission Management</h1>
      <p class="text-slate-500 mt-1">Manage online admissions for Math Solution & Exam Center Mymensingh</p>
    </div>
    <div class="flex items-center gap-3">
      <button onclick="bulkApproveAll()" class="inline-flex items-center gap-2 px-4 py-2.5 bg-green-50 text-green-700 border border-green-200 rounded-xl font-medium hover:bg-green-100 transition-colors text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Approve All Pending
      </button>
      <button onclick="bulkRejectAll()" class="inline-flex items-center gap-2 px-4 py-2.5 bg-red-50 text-red-700 border border-red-200 rounded-xl font-medium hover:bg-red-100 transition-colors text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
        </svg>
        Reject All Pending
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">Total Applications</p>
          <p class="text-2xl font-bold text-slate-900">{totalApplications}</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-yellow-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">Pending Review</p>
          <p class="text-2xl font-bold text-slate-900">{pendingCount}</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">Approved</p>
          <p class="text-2xl font-bold text-slate-900">{approvedCount}</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">Rejected</p>
          <p class="text-2xl font-bold text-slate-900">{rejectedCount}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="card p-5 mb-6">
    <div class="flex flex-col lg:flex-row gap-4">
      <div class="flex-1 relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          placeholder="Search by name, ID, or phone..."
          class="input-field pl-10"
          id="searchInput"
          oninput="filterAdmissions()"
        />
      </div>
      <div class="flex flex-col sm:flex-row gap-3">
        <select class="input-field w-full sm:w-40" id="statusFilter" onchange="filterAdmissions()">
          <option value="">All Status</option>
          <option value="pending">Pending</option>
          <option value="approved">Approved</option>
          <option value="rejected">Rejected</option>
        </select>
        <select class="input-field w-full sm:w-40" id="gradeFilter" onchange="filterAdmissions()">
          <option value="">All Grades</option>
          <option value="5">Class 5</option>
          <option value="6">Class 6</option>
          <option value="7">Class 7</option>
          <option value="8">Class 8</option>
          <option value="9">Class 9</option>
          <option value="10">Class 10</option>
        </select>
      </div>
    </div>
  </div>

  <div id="bulkActions" class="hidden card p-4 mb-6 bg-primary-50 border-primary-200">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="text-sm font-medium text-primary-700" id="selectedCount">0 selected</span>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="bulkApprove()" class="px-3 py-1.5 text-sm font-medium text-green-700 bg-green-100 rounded-lg hover:bg-green-200 transition-colors">
          Approve
        </button>
        <button onclick="bulkReject()" class="px-3 py-1.5 text-sm font-medium text-red-700 bg-red-100 rounded-lg hover:bg-red-200 transition-colors">
          Reject
        </button>
        <button onclick="bulkDelete()" class="px-3 py-1.5 text-sm font-medium text-slate-700 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">
          Delete
        </button>
      </div>
    </div>
  </div>

  <div class="card overflow-hidden mb-6">
    {admissions.length === 0 ? (
      <div class="text-center py-16">
        <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
        </svg>
        <p class="text-slate-500 font-medium">No admissions found</p>
        <p class="text-sm text-slate-400 mt-1">Admission applications will appear here.</p>
      </div>
    ) : (
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100">
            <th class="px-5 py-4 text-left">
              <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="w-4 h-4 rounded border-slate-300 text-primary-600 focus:ring-primary-500 cursor-pointer" />
            </th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Student Name</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Grade</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Phone</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Parent Name</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Applied Date</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody id="admissionsTableBody" class="divide-y divide-slate-100">
          {admissions.map((adm) => (
            <tr class="hover:bg-slate-50 transition-colors" data-id={adm.id} data-name={adm.name} data-grade={adm.grade} data-status={adm.status} data-phone={adm.phone} data-parent={adm.parentName} data-date={adm.appliedDate} data-address={adm.address} data-parent-phone={adm.parentPhone}>
              <td class="px-5 py-4">
                <input type="checkbox" class="row-checkbox w-4 h-4 rounded border-slate-300 text-primary-600 focus:ring-primary-500 cursor-pointer" onchange="updateBulkActions()" />
              </td>
              <td class="px-5 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary-400 to-secondary-500 flex items-center justify-center text-white text-sm font-semibold shadow-sm">
                    {adm.name.split(' ').map(n => n[0]).join('').slice(0, 2)}
                  </div>
                  <div>
                    <span class="font-medium text-slate-900 block">{adm.name}</span>
                    <span class="text-xs text-slate-400">{adm.id}</span>
                  </div>
                </div>
              </td>
              <td class="px-5 py-4">
                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-secondary-100 text-secondary-700">
                  {adm.grade}
                </span>
              </td>
              <td class="px-5 py-4 text-sm text-slate-600">{adm.phone}</td>
              <td class="px-5 py-4 text-sm text-slate-600">{adm.parentName}</td>
              <td class="px-5 py-4 text-sm text-slate-500">{adm.appliedDate}</td>
              <td class="px-5 py-4">
                {adm.status === 'pending' && (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-yellow-100 text-yellow-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
                    Pending
                  </span>
                )}
                {adm.status === 'approved' && (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-green-100 text-green-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                    Approved
                  </span>
                )}
                {adm.status === 'rejected' && (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-red-100 text-red-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                    Rejected
                  </span>
                )}
              </td>
              <td class="px-5 py-4">
                <div class="flex items-center gap-1">
                  {adm.status === 'pending' && (
                    <>
                      <button title="Approve" onclick={`approveAdmission('${adm.id}')`} class="p-2 text-slate-400 hover:text-green-600 hover:bg-green-50 rounded-lg transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                      </button>
                      <button title="Reject" onclick={`rejectAdmission('${adm.id}')`} class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                      </button>
                    </>
                  )}
                  <button title="Delete" onclick={`deleteAdmission('${adm.id}')`} class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    )}
  </div>

  <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm text-slate-500">Showing <span class="font-semibold text-slate-700">1-{totalApplications}</span> of <span class="font-semibold text-slate-700">{totalApplications}</span> applications</p>
  </div>

  <script is:inline>
    function approveAdmission(id) {
      if (confirm('Are you sure you want to approve this admission?')) {
        alert(`Admission ${id} approved successfully!`);
        location.reload();
      }
    }

    function rejectAdmission(id) {
      if (confirm('Are you sure you want to reject this admission?')) {
        alert(`Admission ${id} rejected.`);
        location.reload();
      }
    }

    function deleteAdmission(id) {
      if (confirm(`Are you sure you want to delete admission ${id}? This action cannot be undone.`)) {
        alert(`Admission ${id} deleted.`);
        location.reload();
      }
    }

    function bulkApproveAll() {
      if (confirm('Are you sure you want to approve ALL pending admissions?')) {
        alert('All pending admissions approved!');
        location.reload();
      }
    }

    function bulkRejectAll() {
      if (confirm('Are you sure you want to reject ALL pending admissions?')) {
        alert('All pending admissions rejected.');
        location.reload();
      }
    }

    function filterAdmissions() {
      const search = document.getElementById('searchInput').value.toLowerCase();
      const status = document.getElementById('statusFilter').value;
      const grade = document.getElementById('gradeFilter').value;
      const rows = document.querySelectorAll('#admissionsTableBody tr');
      rows.forEach(row => {
        const el = row;
        const name = el.dataset.name?.toLowerCase() || '';
        const id = el.dataset.id?.toLowerCase() || '';
        const phone = el.dataset.phone?.toLowerCase() || '';
        const parent = el.dataset.parent?.toLowerCase() || '';
        const rowStatus = el.dataset.status || '';
        const rowGrade = el.dataset.grade || '';
        const matchSearch = !search || name.includes(search) || id.includes(search) || phone.includes(search) || parent.includes(search);
        const matchStatus = !status || rowStatus === status;
        const matchGrade = !grade || rowGrade === grade;
        el.style.display = matchSearch && matchStatus && matchGrade ? '' : 'none';
      });
    }

    function toggleSelectAll() {
      const checked = document.getElementById('selectAll').checked;
      document.querySelectorAll('.row-checkbox').forEach(cb => {
        cb.checked = checked;
      });
      updateBulkActions();
    }

    function updateBulkActions() {
      const checked = document.querySelectorAll('.row-checkbox:checked').length;
      const bulkBar = document.getElementById('bulkActions');
      const countEl = document.getElementById('selectedCount');
      if (checked > 0) {
        bulkBar?.classList.remove('hidden');
        countEl.textContent = `${checked} selected`;
      } else {
        bulkBar?.classList.add('hidden');
      }
    }

    function bulkApprove() {
      const count = document.querySelectorAll('.row-checkbox:checked').length;
      if (confirm(`Approve ${count} selected admission(s)?`)) {
        alert(`${count} admission(s) approved!`);
        location.reload();
      }
    }

    function bulkReject() {
      const count = document.querySelectorAll('.row-checkbox:checked').length;
      if (confirm(`Reject ${count} selected admission(s)?`)) {
        alert(`${count} admission(s) rejected.`);
        location.reload();
      }
    }

    function bulkDelete() {
      const count = document.querySelectorAll('.row-checkbox:checked').length;
      if (confirm(`Are you sure you want to delete ${count} admission(s)? This cannot be undone.`)) {
        alert(`${count} admission(s) deleted.`);
        location.reload();
      }
    }
  </script>
</AdminLayout>
