---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createClient } from '../../lib/supabase-server';
const { supabase } = createClient(Astro.request, Astro.cookies);

const { data: noticesData } = await supabase
  .from('notices')
  .select('*')
  .order('published_at', { ascending: false });

const notices = (noticesData || []).map(n => ({
  id: `NTC-${String(n.id).padStart(3, '0')}`,
  title: n.title || 'Untitled',
  content: n.content || '',
  important: n.is_important || false,
  date: n.published_at ? new Date(n.published_at).toISOString().split('T')[0] : 'N/A',
  hasPdf: !!n.pdf_url,
  pdfName: n.pdf_url ? n.pdf_url.split('/').pop() || '' : '',
}));

const importantCount = notices.filter(n => n.important).length;
const withPdfCount = notices.filter(n => n.hasPdf).length;
---

<AdminLayout title="Notice Management">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Notice Management</h1>
      <p class="text-slate-500 mt-1">Manage notices for Math Solution & Exam Center Mymensingh</p>
    </div>
    <button
      onclick="openModal()"
      class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-primary-600 to-primary-700 text-white rounded-xl font-semibold shadow-lg shadow-primary-600/25 hover:shadow-xl hover:shadow-primary-600/30 transition-all duration-200"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Publish Notice
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">Total Notices</p>
          <p class="text-2xl font-bold text-slate-900">{notices.length}</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">Important</p>
          <p class="text-2xl font-bold text-slate-900">{importantCount}</p>
        </div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-slate-500">With PDF</p>
          <p class="text-2xl font-bold text-slate-900">{withPdfCount}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="p-5 border-b border-slate-100">
      <div class="flex flex-col lg:flex-row gap-4">
        <div class="flex-1 relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input type="text" placeholder="Search notices..." class="input-field pl-10" id="searchInput" oninput="filterNotices()" />
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <select class="input-field w-full sm:w-40" id="importantFilter" onchange="filterNotices()">
            <option value="">All Notices</option>
            <option value="true">Important Only</option>
            <option value="false">Non-Important</option>
          </select>
          <select class="input-field w-full sm:w-40" id="pdfFilter" onchange="filterNotices()">
            <option value="">All</option>
            <option value="true">With PDF</option>
            <option value="false">Without PDF</option>
          </select>
        </div>
      </div>
    </div>

    {notices.length === 0 ? (
      <div class="text-center py-16">
        <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        <p class="text-slate-500 font-medium">No notices found</p>
        <p class="text-sm text-slate-400 mt-1">Publish notices to keep students informed.</p>
      </div>
    ) : (
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100">
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Title</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Content Preview</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Important</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Published Date</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">PDF Attached</th>
            <th class="px-5 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody id="noticesTableBody" class="divide-y divide-slate-100">
          {notices.map((notice) => (
            <tr class="hover:bg-slate-50 transition-colors" data-id={notice.id} data-important={notice.important} data-pdf={notice.hasPdf}>
              <td class="px-5 py-4">
                <div class="flex items-center gap-3">
                  {notice.important && (
                    <span class="flex-shrink-0 w-2 h-2 rounded-full bg-red-500"></span>
                  )}
                  <p class="font-medium text-slate-900">{notice.title}</p>
                </div>
              </td>
              <td class="px-5 py-4 max-w-xs">
                <p class="text-sm text-slate-500 truncate">{notice.content}</p>
              </td>
              <td class="px-5 py-4">
                {notice.important ? (
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold bg-red-100 text-red-700">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    Yes
                  </span>
                ) : (
                  <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600">No</span>
                )}
              </td>
              <td class="px-5 py-4 text-sm text-slate-600">{notice.date}</td>
              <td class="px-5 py-4">
                {notice.hasPdf ? (
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold bg-green-100 text-green-700">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                    </svg>
                    {notice.pdfName}
                  </span>
                ) : (
                  <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600">No</span>
                )}
              </td>
              <td class="px-5 py-4">
                <div class="flex items-center gap-1">
                  <button title="Delete" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    )}

    <div class="p-5 border-t border-slate-100">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-slate-500">Showing <span class="font-semibold text-slate-700">1-{notices.length}</span> of <span class="font-semibold text-slate-700">{notices.length}</span> notices</p>
      </div>
    </div>
  </div>

  <div id="noticeModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg mx-4">
      <div class="card p-0 overflow-hidden animate-in">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
          <h3 id="modalTitle" class="text-lg font-bold text-slate-900">Publish New Notice</h3>
          <button onclick="closeModal()" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form id="noticeForm" onsubmit="handleSubmit(event)" class="p-6 space-y-4">
          <input type="hidden" id="formAction" value="add" />
          <input type="hidden" id="editNoticeId" value="" />
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Title</label>
            <input type="text" id="noticeTitle" required class="input-field" placeholder="e.g. Annual Math Olympiad 2026" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Content</label>
            <textarea id="noticeContent" rows="5" required class="input-field" placeholder="Write the notice content here..."></textarea>
          </div>
          <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
            <button type="button" onclick="closeModal()" class="px-5 py-2.5 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
              Cancel
            </button>
            <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-gradient-to-r from-primary-600 to-primary-700 rounded-xl shadow-lg shadow-primary-600/25 hover:shadow-xl hover:shadow-primary-600/30 transition-all duration-200">
              Publish Notice
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <style>
    @keyframes animate-in {
      from { opacity: 0; transform: translate(-50%, -50%) scale(0.95); }
      to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    }
    .animate-in {
      animation: animate-in 0.2s ease-out;
    }
  </style>

  <script is:inline>
    function openModal() {
      document.getElementById('formAction').value = 'add';
      document.getElementById('editNoticeId').value = '';
      document.getElementById('modalTitle').textContent = 'Publish New Notice';
      document.getElementById('noticeForm').reset();
      document.getElementById('noticeModal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('noticeModal').classList.add('hidden');
    }

    function handleSubmit(e) {
      e.preventDefault();
      const action = document.getElementById('formAction').value;
      if (action === 'add') {
        alert('Notice published successfully!');
      } else {
        alert('Notice updated successfully!');
      }
      closeModal();
    }

    function deleteNotice(id) {
      if (confirm('Are you sure you want to delete this notice?')) {
        alert('Notice deleted successfully!');
      }
    }

    function filterNotices() {
      const search = document.getElementById('searchInput').value.toLowerCase();
      const important = document.getElementById('importantFilter').value;
      const pdf = document.getElementById('pdfFilter').value;
      const rows = document.querySelectorAll('#noticesTableBody tr');
      rows.forEach(row => {
        const el = row;
        const title = el.querySelector('td:nth-child(1)')?.textContent?.toLowerCase() || '';
        const content = el.querySelector('td:nth-child(2)')?.textContent?.toLowerCase() || '';
        const rowImportant = el.dataset.important || '';
        const rowPdf = el.dataset.pdf || '';
        const matchSearch = !search || title.includes(search) || content.includes(search);
        const matchImportant = !important || rowImportant === important;
        const matchPdf = !pdf || rowPdf === pdf;
        el.style.display = matchSearch && matchImportant && matchPdf ? '' : 'none';
      });
    }
  </script>
</AdminLayout>
