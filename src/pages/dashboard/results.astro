---
import StudentLayout from '../../layouts/StudentLayout.astro';
import { createClient } from '../../lib/supabase-server';

const { supabase } = createClient(Astro.request, Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();
const { data: profile } = await supabase.from('profiles').select('full_name').eq('id', user?.id).single();
const studentName = profile?.full_name || 'Student';

const results = [
  {
    id: '1',
    examName: 'Algebra - Chapter 5 Test',
    date: 'Sep 10, 2026',
    totalMarks: 100,
    obtainedMarks: 85,
    percentage: 85,
    status: 'Pass',
    totalQuestions: 20,
    correct: 17,
    wrong: 2,
    skipped: 1,
    timeTaken: '1h 15m'
  },
  {
    id: '2',
    examName: 'Calculus - Midterm',
    date: 'Sep 5, 2026',
    totalMarks: 100,
    obtainedMarks: 72,
    percentage: 72,
    status: 'Pass',
    totalQuestions: 25,
    correct: 18,
    wrong: 4,
    skipped: 3,
    timeTaken: '1h 45m'
  },
  {
    id: '3',
    examName: 'Geometry - Quiz 3',
    date: 'Sep 1, 2026',
    totalMarks: 50,
    obtainedMarks: 22,
    percentage: 44,
    status: 'Fail',
    totalQuestions: 15,
    correct: 7,
    wrong: 5,
    skipped: 3,
    timeTaken: '45m'
  },
  {
    id: '4',
    examName: 'Trigonometry - Chapter 2',
    date: 'Aug 28, 2026',
    totalMarks: 100,
    obtainedMarks: 91,
    percentage: 91,
    status: 'Pass',
    totalQuestions: 20,
    correct: 18,
    wrong: 1,
    skipped: 1,
    timeTaken: '1h 10m'
  },
  {
    id: '5',
    examName: 'Statistics - Unit Test',
    date: 'Aug 22, 2026',
    totalMarks: 100,
    obtainedMarks: 78,
    percentage: 78,
    status: 'Pass',
    totalQuestions: 25,
    correct: 19,
    wrong: 3,
    skipped: 3,
    timeTaken: '1h 30m'
  },
  {
    id: '6',
    examName: 'Linear Algebra - Quiz 2',
    date: 'Aug 18, 2026',
    totalMarks: 50,
    obtainedMarks: 42,
    percentage: 84,
    status: 'Pass',
    totalQuestions: 10,
    correct: 8,
    wrong: 1,
    skipped: 1,
    timeTaken: '35m'
  },
  {
    id: '7',
    examName: 'Number Theory - Assignment 1',
    date: 'Aug 15, 2026',
    totalMarks: 50,
    obtainedMarks: 38,
    percentage: 76,
    status: 'Pass',
    totalQuestions: 10,
    correct: 7,
    wrong: 2,
    skipped: 1,
    timeTaken: '40m'
  },
  {
    id: '8',
    examName: 'Probability - Chapter Test',
    date: 'Aug 10, 2026',
    totalMarks: 100,
    obtainedMarks: 65,
    percentage: 65,
    status: 'Pass',
    totalQuestions: 20,
    correct: 13,
    wrong: 4,
    skipped: 3,
    timeTaken: '1h 20m'
  }
];

const totalExams = results.length;
const passedExams = results.filter(r => r.status === 'Pass').length;
const passRate = Math.round((passedExams / totalExams) * 100);
const averageScore = Math.round(results.reduce((sum, r) => sum + r.percentage, 0) / totalExams);
---

<StudentLayout title="My Results" studentName={studentName}>
  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-2">My Results</h1>
    <p class="text-slate-500">Track your exam performance and progress</p>
  </div>

  <!-- Summary Stats -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="card p-6">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-primary-100 flex items-center justify-center">
          <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
        </div>
        <div>
          <p class="text-3xl font-bold text-slate-900">{totalExams}</p>
          <p class="text-sm text-slate-500">Total Exams</p>
        </div>
      </div>
    </div>
    <div class="card p-6">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-success-500/10 flex items-center justify-center">
          <svg class="w-7 h-7 text-success-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="text-3xl font-bold text-slate-900">{passRate}%</p>
          <p class="text-sm text-slate-500">Pass Rate</p>
        </div>
      </div>
    </div>
    <div class="card p-6">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-secondary-100 flex items-center justify-center">
          <svg class="w-7 h-7 text-secondary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <div>
          <p class="text-3xl font-bold text-slate-900">{averageScore}%</p>
          <p class="text-sm text-slate-500">Average Score</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="mb-6">
    <div class="flex flex-wrap gap-2">
      <button class="filter-btn active px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 bg-primary-600 text-white shadow-md shadow-primary-600/20" data-filter="all">
        All ({totalExams})
      </button>
      <button class="filter-btn px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 bg-white text-slate-600 border border-slate-200 hover:border-primary-300 hover:text-primary-600" data-filter="pass">
        Passed ({passedExams})
      </button>
      <button class="filter-btn px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 bg-white text-slate-600 border border-slate-200 hover:border-danger-300 hover:text-danger-600" data-filter="fail">
        Failed ({totalExams - passedExams})
      </button>
    </div>
  </div>

  <!-- Results Table (Desktop) -->
  <div class="hidden md:block card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100">
            <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wider px-6 py-4">Exam Name</th>
            <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wider px-6 py-4">Date</th>
            <th class="text-center text-xs font-semibold text-slate-500 uppercase tracking-wider px-6 py-4">Total</th>
            <th class="text-center text-xs font-semibold text-slate-500 uppercase tracking-wider px-6 py-4">Obtained</th>
            <th class="text-center text-xs font-semibold text-slate-500 uppercase tracking-wider px-6 py-4">Percentage</th>
            <th class="text-center text-xs font-semibold text-slate-500 uppercase tracking-wider px-6 py-4">Status</th>
            <th class="text-center text-xs font-semibold text-slate-500 uppercase tracking-wider px-6 py-4">Action</th>
          </tr>
        </thead>
        <tbody>
          {results.map((result) => (
            <tr class="result-row border-b border-slate-50 hover:bg-slate-50/50 transition-colors" data-status={result.status.toLowerCase()}>
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class={`w-10 h-10 rounded-xl flex items-center justify-center ${
                    result.status === 'Pass' ? 'bg-success-500/10 text-success-500' : 'bg-danger-500/10 text-danger-500'
                  }`}>
                    {result.status === 'Pass' ? (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    ) : (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    )}
                  </div>
                  <span class="font-medium text-slate-900">{result.examName}</span>
                </div>
              </td>
              <td class="px-6 py-4 text-sm text-slate-500">{result.date}</td>
              <td class="px-6 py-4 text-sm text-slate-600 text-center font-medium">{result.totalMarks}</td>
              <td class="px-6 py-4 text-center">
                <span class={`text-sm font-bold ${
                  result.percentage >= 70 ? 'text-success-600' : result.percentage >= 50 ? 'text-warning-600' : 'text-danger-600'
                }`}>
                  {result.obtainedMarks}
                </span>
              </td>
              <td class="px-6 py-4 text-center">
                <div class="flex items-center justify-center gap-2">
                  <div class="w-16 h-2 bg-slate-100 rounded-full overflow-hidden">
                    <div 
                      class={`h-full rounded-full ${
                        result.percentage >= 70 ? 'bg-success-500' : result.percentage >= 50 ? 'bg-warning-500' : 'bg-danger-500'
                      }`}
                      style={`width: ${result.percentage}%`}
                    ></div>
                  </div>
                  <span class={`text-sm font-semibold ${
                    result.percentage >= 70 ? 'text-success-600' : result.percentage >= 50 ? 'text-warning-600' : 'text-danger-600'
                  }`}>
                    {result.percentage}%
                  </span>
                </div>
              </td>
              <td class="px-6 py-4 text-center">
                <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${
                  result.status === 'Pass'
                    ? 'bg-success-500/10 text-success-600'
                    : 'bg-danger-500/10 text-danger-600'
                }`}>
                  {result.status}
                </span>
              </td>
              <td class="px-6 py-4 text-center">
                <a 
                  href={`/dashboard/result/${result.id}`}
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary-50 text-primary-600 text-sm font-semibold hover:bg-primary-100 transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  View
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Results Cards (Mobile) -->
  <div class="md:hidden space-y-4">
    {results.map((result) => (
      <div class="result-card card p-5" data-status={result.status.toLowerCase()}>
        <div class="flex items-start justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center ${
              result.status === 'Pass' ? 'bg-success-500/10 text-success-500' : 'bg-danger-500/10 text-danger-500'
            }`}>
              {result.status === 'Pass' ? (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              ) : (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
            </div>
            <div>
              <h3 class="font-semibold text-slate-900">{result.examName}</h3>
              <p class="text-sm text-slate-500">{result.date}</p>
            </div>
          </div>
          <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${
            result.status === 'Pass'
              ? 'bg-success-500/10 text-success-600'
              : 'bg-danger-500/10 text-danger-600'
          }`}>
            {result.status}
          </span>
        </div>

        <div class="grid grid-cols-3 gap-4 mb-4">
          <div class="text-center p-3 bg-slate-50 rounded-xl">
            <p class="text-lg font-bold text-slate-900">{result.obtainedMarks}</p>
            <p class="text-xs text-slate-500">Obtained</p>
          </div>
          <div class="text-center p-3 bg-slate-50 rounded-xl">
            <p class="text-lg font-bold text-slate-900">{result.totalMarks}</p>
            <p class="text-xs text-slate-500">Total</p>
          </div>
          <div class="text-center p-3 bg-slate-50 rounded-xl">
            <p class={`text-lg font-bold ${
              result.percentage >= 70 ? 'text-success-600' : result.percentage >= 50 ? 'text-warning-600' : 'text-danger-600'
            }`}>{result.percentage}%</p>
            <p class="text-xs text-slate-500">Score</p>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 text-sm text-slate-500">
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {result.timeTaken}
            </span>
            <span class="text-slate-300">•</span>
            <span>{result.totalQuestions} questions</span>
          </div>
          <a 
            href={`/dashboard/result/${result.id}`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary-50 text-primary-600 text-sm font-semibold hover:bg-primary-100 transition-colors"
          >
            View Details
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    ))}
  </div>
</StudentLayout>

<script is:inline>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const resultRows = document.querySelectorAll('.result-row');
  const resultCards = document.querySelectorAll('.result-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      filterBtns.forEach(b => {
        b.classList.remove('bg-primary-600', 'text-white', 'shadow-md', 'shadow-primary-600/20');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });

      btn.classList.add('bg-primary-600', 'text-white', 'shadow-md', 'shadow-primary-600/20');
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');

      resultRows.forEach(row => {
        const status = row.getAttribute('data-status');
        if (filter === 'all' || (filter === 'pass' && status === 'pass') || (filter === 'fail' && status === 'fail')) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });

      resultCards.forEach(card => {
        const status = card.getAttribute('data-status');
        if (filter === 'all' || (filter === 'pass' && status === 'pass') || (filter === 'fail' && status === 'fail')) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
