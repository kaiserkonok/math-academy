---
import StudentLayout from '../../layouts/StudentLayout.astro';
import { createClient } from '../../lib/supabase-server';

const supabase = createClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();
const { data: profile } = await supabase.from('profiles').select('full_name').eq('id', user?.id).single();
const studentName = profile?.full_name || 'Student';

const today = new Date();
const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const daysOfWeek = ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'];

const classRoutine: Record<string, Array<{ time: string; subject: string; chapter: string; room: string }>> = {
  Saturday: [
    { time: '4:00 - 4:45 PM', subject: 'Algebra', chapter: 'Ch: 3 - Linear Equations', room: 'Room 101' },
    { time: '4:45 - 5:30 PM', subject: 'Geometry', chapter: 'Ch: 5 - Triangles', room: 'Room 101' },
    { time: '5:45 - 6:30 PM', subject: 'Physics', chapter: 'Ch: 2 - Motion', room: 'Room 203' },
    { time: '6:30 - 7:15 PM', subject: 'English', chapter: 'Ch: 4 - Grammar', room: 'Room 203' },
  ],
  Sunday: [
    { time: '4:00 - 4:45 PM', subject: 'Mathematics', chapter: 'Ch: 7 - Statistics', room: 'Room 102' },
    { time: '4:45 - 5:30 PM', subject: 'Chemistry', chapter: 'Ch: 1 - Matter', room: 'Room 102' },
    { time: '5:45 - 6:30 PM', subject: 'Bengali', chapter: 'Ch: 6 - Poetry', room: 'Room 301' },
  ],
  Monday: [
    { time: '4:00 - 4:45 PM', subject: 'Algebra', chapter: 'Ch: 4 - Quadratics', room: 'Room 101' },
    { time: '4:45 - 5:30 PM', subject: 'Geometry', chapter: 'Ch: 6 - Circles', room: 'Room 101' },
    { time: '5:45 - 6:30 PM', subject: 'Biology', chapter: 'Ch: 3 - Cell Biology', room: 'Room 204' },
  ],
  Tuesday: [
    { time: '4:00 - 4:45 PM', subject: 'Mathematics', chapter: 'Ch: 8 - Probability', room: 'Room 102' },
    { time: '4:45 - 5:30 PM', subject: 'Physics', chapter: 'Ch: 3 - Forces', room: 'Room 203' },
    { time: '5:45 - 6:30 PM', subject: 'English', chapter: 'Ch: 5 - Comprehension', room: 'Room 203' },
    { time: '6:30 - 7:15 PM', subject: 'ICT', chapter: 'Ch: 1 - Fundamentals', room: 'Room 105' },
  ],
  Wednesday: [
    { time: '4:00 - 4:45 PM', subject: 'Algebra', chapter: 'Ch: 5 - Polynomials', room: 'Room 101' },
    { time: '4:45 - 5:30 PM', subject: 'Chemistry', chapter: 'Ch: 2 - Elements', room: 'Room 102' },
    { time: '5:45 - 6:30 PM', subject: 'Bengali', chapter: 'Ch: 7 - Drama', room: 'Room 301' },
  ],
  Thursday: [
    { time: '4:00 - 4:45 PM', subject: 'Mathematics', chapter: 'Ch: 9 - Mensuration', room: 'Room 102' },
    { time: '4:45 - 5:30 PM', subject: 'Geometry', chapter: 'Ch: 7 - Mensuration', room: 'Room 101' },
    { time: '5:45 - 6:30 PM', subject: 'Physics', chapter: 'Ch: 4 - Energy', room: 'Room 203' },
  ],
};

const examRoutine: Record<string, Array<{ time: string; subject: string; chapter: string; type: string }>> = {
  Saturday: [],
  Sunday: [
    { time: '9:00 - 11:00 AM', subject: 'Mathematics', chapter: 'Full Syllabus', type: 'Model Test' },
  ],
  Monday: [],
  Tuesday: [
    { time: '9:00 - 11:00 AM', subject: 'Physics', chapter: 'Ch 1-5', type: 'Weekly Quiz' },
  ],
  Wednesday: [],
  Thursday: [
    { time: '9:00 - 11:00 AM', subject: 'Chemistry', chapter: 'Ch 1-4', type: 'Monthly Exam' },
    { time: '2:00 - 4:00 PM', subject: 'English', chapter: 'Full Syllabus', type: 'Model Test' },
  ],
};

const todayDayName = dayNames[today.getDay()];
const adjustedToday = todayDayName === 'Friday' ? 'Saturday' : todayDayName;
const todaySchedule = classRoutine[adjustedToday] || [];
const adjustedDay = adjustedToday;

const subjectColors: Record<string, string> = {
  'Algebra': 'bg-primary-100 text-primary-700 border-primary-200',
  'Mathematics': 'bg-primary-100 text-primary-700 border-primary-200',
  'Geometry': 'bg-secondary-100 text-secondary-700 border-secondary-200',
  'Physics': 'bg-amber-100 text-amber-700 border-amber-200',
  'Chemistry': 'bg-emerald-100 text-emerald-700 border-emerald-200',
  'Biology': 'bg-teal-100 text-teal-700 border-teal-200',
  'English': 'bg-rose-100 text-rose-700 border-rose-200',
  'Bengali': 'bg-violet-100 text-violet-700 border-violet-200',
  'ICT': 'bg-cyan-100 text-cyan-700 border-cyan-200',
};

const examTypeColors: Record<string, string> = {
  'Model Test': 'bg-red-100 text-red-700',
  'Weekly Quiz': 'bg-blue-100 text-blue-700',
  'Monthly Exam': 'bg-purple-100 text-purple-700',
};

const accentDots: Record<string, string> = {
  'Algebra': 'bg-primary-500',
  'Mathematics': 'bg-primary-500',
  'Geometry': 'bg-secondary-500',
  'Physics': 'bg-amber-500',
  'Chemistry': 'bg-emerald-500',
  'Biology': 'bg-teal-500',
  'English': 'bg-rose-500',
  'Bengali': 'bg-violet-500',
  'ICT': 'bg-cyan-500',
};
---

<StudentLayout title="My Routine" studentName={studentName}>

  <!-- Page Header -->
  <section class="mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl lg:text-3xl font-extrabold text-slate-900">My Routine</h1>
        <p class="text-slate-500 mt-1">
          {today.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
      </div>
      <div class="flex items-center gap-2 bg-primary-50 rounded-xl px-4 py-2 border border-primary-100">
        <div class="w-2 h-2 rounded-full bg-success-500 animate-pulse"></div>
        <span class="text-sm font-semibold text-primary-700">Active Semester</span>
      </div>
    </div>
  </section>

  <!-- Routine Tabs -->
  <section class="mb-6">
    <div class="inline-flex bg-slate-100 rounded-xl p-1">
      <button id="tab-class" class="routine-tab active px-6 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 bg-white text-slate-900 shadow-sm" data-tab="class">
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          Class Routine
        </span>
      </button>
      <button id="tab-exam" class="routine-tab px-6 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-500 hover:text-slate-700" data-tab="exam">
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          Exam Routine
        </span>
      </button>
    </div>
  </section>

  <!-- Today's Schedule -->
  {todaySchedule.length > 0 && (
    <section id="today-section" class="mb-8">
      <div class="card overflow-hidden">
        <div class="gradient-bg px-6 py-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <div>
              <h2 class="text-white font-bold">Today's Classes</h2>
              <p class="text-white/70 text-sm">{adjustedDay} - {todaySchedule.length} classes scheduled</p>
            </div>
          </div>
        </div>
        <div class="p-6">
          <div class="grid gap-3">
            {todaySchedule.map((cls) => (
              <div class="flex items-center gap-4 p-3 rounded-xl bg-slate-50 hover:bg-slate-100 transition-colors group">
                <div class={`w-3 h-3 rounded-full ${accentDots[cls.subject] || 'bg-slate-400'} shrink-0 group-hover:scale-125 transition-transform`}></div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-semibold text-slate-900">{cls.subject}</span>
                    <span class={`px-2 py-0.5 rounded text-xs font-medium ${subjectColors[cls.subject] || 'bg-slate-100 text-slate-600'}`}>{cls.chapter}</span>
                  </div>
                </div>
                <div class="text-right shrink-0">
                  <p class="text-sm font-medium text-slate-700">{cls.time}</p>
                  <p class="text-xs text-slate-400">{cls.room}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Weekly Calendar View -->
  <section id="content-class" class="routine-content">
    <div class="card overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Weekly Class Schedule
        </h2>
        <p class="text-sm text-slate-500 mt-1">Saturday - Thursday</p>
      </div>

      <!-- Day Navigation -->
      <div class="px-6 py-3 border-b border-slate-100 bg-slate-50/50 overflow-x-auto">
        <div class="flex gap-2 min-w-max">
          {daysOfWeek.map((day) => {
            const isToday = day === adjustedToday;
            const classCount = (classRoutine[day] || []).length;
            return (
              <button class={`day-nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 whitespace-nowrap ${
                isToday
                  ? 'bg-primary-600 text-white shadow-md shadow-primary-500/25'
                  : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'
              }`} data-day={day}>
                <span class="block">{day.slice(0, 3)}</span>
                <span class={`block text-xs mt-0.5 ${isToday ? 'text-white/70' : 'text-slate-400'}`}>{classCount} classes</span>
              </button>
            );
          })}
        </div>
      </div>

      <!-- Calendar Grid -->
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
          {daysOfWeek.map((day) => {
            const classes = classRoutine[day] || [];
            const isToday = day === adjustedToday;
            return (
              <div class={`day-column rounded-xl border-2 transition-all duration-200 ${
                isToday
                  ? 'border-primary-300 bg-primary-50/30 shadow-md shadow-primary-500/10'
                  : 'border-slate-200 bg-white hover:border-slate-300'
              }`} data-day={day}>
                <div class={`px-4 py-3 border-b ${isToday ? 'border-primary-200' : 'border-slate-100'}`}>
                  <div class="flex items-center justify-between">
                    <h3 class={`font-bold ${isToday ? 'text-primary-700' : 'text-slate-900'}`}>{day}</h3>
                    {isToday && (
                      <span class="px-2 py-0.5 rounded-full bg-primary-600 text-white text-xs font-semibold">Today</span>
                    )}
                  </div>
                  <p class="text-xs text-slate-400 mt-0.5">{classes.length} classes</p>
                </div>

                <div class="p-3 space-y-2">
                  {classes.length === 0 ? (
                    <div class="py-6 text-center">
                      <svg class="w-8 h-8 text-slate-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
                      <p class="text-sm text-slate-400">No classes</p>
                    </div>
                  ) : (
                    classes.map((cls) => (
                      <div class="p-3 rounded-lg bg-white border border-slate-100 hover:shadow-sm transition-shadow group">
                        <div class="flex items-start gap-2">
                          <div class={`w-2 h-2 rounded-full mt-1.5 shrink-0 ${accentDots[cls.subject] || 'bg-slate-400'}`}></div>
                          <div class="flex-1 min-w-0">
                            <p class="font-semibold text-sm text-slate-900">{cls.subject}</p>
                            <p class="text-xs text-slate-500 mt-0.5 truncate">{cls.chapter}</p>
                            <div class="flex items-center gap-2 mt-1.5">
                              <span class="text-xs text-slate-400 flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                {cls.time}
                              </span>
                              <span class="text-xs text-slate-400 flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                {cls.room}
                              </span>
                            </div>
                          </div>
                        </div>
                      </div>
                    ))
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- Exam Routine Content -->
  <section id="content-exam" class="routine-content hidden">
    <div class="card overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <svg class="w-5 h-5 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          Upcoming Exams
        </h2>
        <p class="text-sm text-slate-500 mt-1">Scheduled tests and model exams</p>
      </div>

      <!-- Exam Table -->
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/50">
              <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Day</th>
              <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Time</th>
              <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Subject</th>
              <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Syllabus</th>
              <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Type</th>
            </tr>
          </thead>
          <tbody>
            {Object.entries(examRoutine).map(([day, exams]) => (
              exams.map((exam, idx) => (
                <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition-colors">
                  {idx === 0 && (
                    <td rowspan={exams.length} class="px-6 py-4 font-semibold text-slate-900 align-top">
                      {day}
                      {day === adjustedToday && (
                        <span class="ml-2 inline-block px-2 py-0.5 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">Today</span>
                      )}
                    </td>
                  )}
                  <td class="px-6 py-4 text-sm text-slate-700">{exam.time}</td>
                  <td class="px-6 py-4">
                    <span class={`inline-block px-2.5 py-1 rounded-lg text-xs font-medium ${subjectColors[exam.subject] || 'bg-slate-100 text-slate-600'}`}>
                      {exam.subject}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-600">{exam.chapter}</td>
                  <td class="px-6 py-4">
                    <span class={`inline-block px-2.5 py-1 rounded-lg text-xs font-semibold ${examTypeColors[exam.type] || 'bg-slate-100 text-slate-600'}`}>
                      {exam.type}
                    </span>
                  </td>
                </tr>
              ))
            ))}
          </tbody>
        </table>
      </div>

      <!-- Empty state if no exams -->
      {Object.values(examRoutine).every(exams => exams.length === 0) && (
        <div class="p-12 text-center">
          <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          <p class="text-slate-500 font-medium">No exams scheduled this week</p>
        </div>
      )}
    </div>
  </section>

  <!-- Weekly Stats -->
  <section class="mt-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="card p-4 text-center group hover:-translate-y-1 transition-transform">
        <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        </div>
        <div class="text-2xl font-extrabold text-slate-900">22</div>
        <div class="text-xs text-slate-500 mt-1">Total Classes/Week</div>
      </div>
      <div class="card p-4 text-center group hover:-translate-y-1 transition-transform">
        <div class="w-12 h-12 rounded-xl bg-secondary-100 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 text-secondary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div class="text-2xl font-extrabold text-slate-900">13.5</div>
        <div class="text-xs text-slate-500 mt-1">Hours/Week</div>
      </div>
      <div class="card p-4 text-center group hover:-translate-y-1 transition-transform">
        <div class="w-12 h-12 rounded-xl bg-success-100 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 text-success-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
        </div>
        <div class="text-2xl font-extrabold text-slate-900">9</div>
        <div class="text-xs text-slate-500 mt-1">Subjects</div>
      </div>
      <div class="card p-4 text-center group hover:-translate-y-1 transition-transform">
        <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        </div>
        <div class="text-2xl font-extrabold text-slate-900">3</div>
        <div class="text-xs text-slate-500 mt-1">Exams This Month</div>
      </div>
    </div>
  </section>

</StudentLayout>

<script is:inline>
  const tabClass = document.getElementById('tab-class');
  const tabExam = document.getElementById('tab-exam');
  const contentClass = document.getElementById('content-class');
  const contentExam = document.getElementById('content-exam');
  const todaySection = document.getElementById('today-section');
  const routineTabs = document.querySelectorAll('.routine-tab');

  function switchTab(tab) {
    routineTabs.forEach((t) => {
      t.classList.remove('bg-white', 'text-slate-900', 'shadow-sm');
      t.classList.add('text-slate-500');
    });

    if (tab === 'class') {
      tabClass?.classList.add('bg-white', 'text-slate-900', 'shadow-sm');
      tabClass?.classList.remove('text-slate-500');
      contentClass?.classList.remove('hidden');
      contentExam?.classList.add('hidden');
      todaySection?.classList.remove('hidden');
    } else {
      tabExam?.classList.add('bg-white', 'text-slate-900', 'shadow-sm');
      tabExam?.classList.remove('text-slate-500');
      contentClass?.classList.add('hidden');
      contentExam?.classList.remove('hidden');
      todaySection?.classList.add('hidden');
    }
  }

  tabClass?.addEventListener('click', () => switchTab('class'));
  tabExam?.addEventListener('click', () => switchTab('exam'));

  // Day navigation click handling
  const dayBtns = document.querySelectorAll('.day-nav-btn');
  const dayColumns = document.querySelectorAll('.day-column');

  dayBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const day = btn.getAttribute('data-day');
      dayBtns.forEach((b) => {
        b.classList.remove('bg-primary-600', 'text-white', 'shadow-md', 'shadow-primary-500/25');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });
      btn.classList.add('bg-primary-600', 'text-white', 'shadow-md', 'shadow-primary-500/25');
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');

      dayColumns.forEach((col) => {
        const colDay = col.getAttribute('data-day');
        if (colDay === day) {
          col.style.transform = 'scale(1.02)';
          col.style.zIndex = '10';
        } else {
          col.style.transform = '';
          col.style.zIndex = '';
        }
      });
    });
  });
</script>
