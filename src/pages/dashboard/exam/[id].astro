---
import StudentLayout from '../../../layouts/StudentLayout.astro';
import { createClient } from '../../../lib/supabase-server';

const { supabase } = createClient(Astro.request, Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();
const { data: profile } = await supabase.from('profiles').select('id, full_name, grade').eq('id', user?.id).single();
const studentName = profile?.full_name || 'Student';

const { id } = Astro.params;

// Fetch exam with questions
const { data: examData, error: examError } = await supabase
  .from('exams')
  .select('*, questions(*)')
  .eq('id', id)
  .eq('is_published', true)
  .single();

if (examError || !examData) {
  return Astro.redirect('/dashboard/exams');
}

const questions = (examData.questions || [])
  .sort((a: any, b: any) => (a.question_order || 0) - (b.question_order || 0))
  .map((q: any) => ({
    id: q.question_order || q.id,
    text: q.question_text,
    options: [
      { label: 'A', text: q.option_a || '' },
      { label: 'B', text: q.option_b || '' },
      { label: 'C', text: q.option_c || '' },
      { label: 'D', text: q.option_d || '' },
    ],
  }));

const examInfo = {
  id: examData.id,
  title: examData.title,
  duration: examData.duration_minutes || 30,
  totalQuestions: questions.length,
};
---

<StudentLayout title={`Exam - ${examInfo.title}`} studentName={studentName}>
  <div id="exam-container" class="fixed inset-0 lg:relative lg:inset-auto lg:h-auto bg-slate-50 lg:bg-transparent z-40 lg:z-auto">
    <!-- Top Bar -->
    <div class="sticky top-0 z-30 bg-white border-b border-slate-200 shadow-sm">
      <div class="flex items-center justify-between px-4 lg:px-6 h-14">
        <!-- Exam Title -->
        <div class="flex items-center gap-3">
          <div class="hidden lg:flex w-10 h-10 rounded-xl bg-gradient-to-br from-primary-500 to-primary-600 items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <div>
            <h1 class="text-sm lg:text-base font-bold text-slate-900 truncate max-w-[180px] lg:max-w-md">{examInfo.title}</h1>
            <p class="text-xs text-slate-500 hidden sm:block">Math Solution & Exam Center</p>
          </div>
        </div>

        <!-- Timer -->
        <div class="flex items-center gap-4">
          <div id="timer-display" class="flex items-center gap-2 px-4 py-2 bg-slate-900 rounded-xl">
            <svg class="w-5 h-5 text-success-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span id="timer-text" class="text-white font-mono font-bold text-lg tracking-wider">30:00</span>
          </div>

          <!-- Question Progress -->
          <div class="hidden sm:flex items-center gap-2 px-3 py-2 bg-primary-50 rounded-xl border border-primary-100">
            <span class="text-xs text-primary-600 font-medium">Q</span>
            <span id="current-q-num" class="text-sm font-bold text-primary-700">1</span>
            <span class="text-xs text-primary-400">/</span>
            <span class="text-sm font-bold text-primary-600">{examInfo.totalQuestions}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="flex flex-col lg:flex-row h-[calc(100vh-3.5rem)] lg:h-[calc(100vh-3.5rem)]">
      <!-- Question Panel (70%) -->
      <div class="flex-1 lg:w-[70%] overflow-y-auto p-4 lg:p-6">
        <div class="max-w-3xl mx-auto">
          <!-- Question Card -->
          <div id="question-card" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <!-- Question Header -->
            <div class="px-5 py-4 bg-gradient-to-r from-slate-50 to-slate-100 border-b border-slate-200">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class="w-10 h-10 rounded-xl bg-primary-500 text-white flex items-center justify-center font-bold text-sm" id="question-badge">1</span>
                  <div>
                    <span class="text-xs text-slate-500 font-medium">Question</span>
                    <h2 id="question-text" class="text-base lg:text-lg font-semibold text-slate-900 leading-relaxed">{questions[0]?.text || ''}</h2>
                  </div>
                </div>
                <button id="mark-review-btn" class="hidden lg:flex items-center gap-2 px-3 py-2 text-sm font-medium text-slate-600 hover:text-warning-600 hover:bg-warning-50 rounded-xl transition-all duration-200" title="Mark for Review">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                  </svg>
                  <span id="mark-review-text">Mark Review</span>
                </button>
              </div>
            </div>

            <!-- Options -->
            <div id="options-container" class="p-5 space-y-3">
              {(questions[0]?.options || []).map((option: any, i: number) => (
                <button
                  class={`option-btn w-full text-left p-4 rounded-xl border-2 transition-all duration-200 flex items-center gap-4 border-slate-200 hover:border-primary-300 hover:bg-primary-50/50`}
                  data-option={option.label}
                >
                  <span class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center font-bold text-sm text-slate-600 flex-shrink-0 option-label">
                    {option.label}
                  </span>
                  <span class="text-sm lg:text-base text-slate-700 font-medium option-text">{option.text}</span>
                  <svg class="w-5 h-5 text-primary-500 ml-auto opacity-0 check-icon transition-opacity duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </button>
              ))}
            </div>

            <!-- Mobile Mark Review Button -->
            <div class="px-5 pb-4 lg:hidden">
              <button id="mark-review-btn-mobile" class="w-full flex items-center justify-center gap-2 px-4 py-3 text-sm font-medium text-slate-600 hover:text-warning-600 hover:bg-warning-50 rounded-xl border border-slate-200 transition-all duration-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                </svg>
                <span id="mark-review-text-mobile">Mark for Review</span>
              </button>
            </div>
          </div>

          <!-- Navigation Buttons (Bottom) -->
          <div class="flex items-center justify-between mt-4 gap-3">
            <button id="prev-btn" class="flex items-center gap-2 px-5 py-3 bg-white border border-slate-200 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              <span class="hidden sm:inline">Previous</span>
            </button>

            <div class="flex items-center gap-2">
              <button id="clear-btn" class="px-4 py-3 bg-white border border-slate-200 text-slate-600 font-medium rounded-xl hover:bg-slate-50 transition-all duration-200 text-sm">
                Clear
              </button>
              <button id="next-btn" class="flex items-center gap-2 px-5 py-3 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 transition-all duration-200 shadow-sm hover:shadow-md disabled:opacity-50 disabled:cursor-not-allowed">
                <span class="hidden sm:inline">Next</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Navigation Panel (30%) - Desktop -->
      <div class="hidden lg:block lg:w-[30%] border-l border-slate-200 bg-white overflow-y-auto">
        <div class="p-5">
          <!-- Panel Header -->
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-slate-900">Questions</h3>
            <div class="flex items-center gap-1.5 text-xs">
              <span class="w-3 h-3 rounded bg-slate-300"></span>
              <span class="text-slate-500">Unvisited</span>
            </div>
          </div>

          <!-- Legend -->
          <div class="grid grid-cols-2 gap-2 mb-5 text-xs">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded bg-slate-300"></span>
              <span class="text-slate-600">Unvisited</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded bg-success-500"></span>
              <span class="text-slate-600">Answered</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded bg-warning-500"></span>
              <span class="text-slate-600">Marked</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded bg-danger-500"></span>
              <span class="text-slate-600">Unanswered</span>
            </div>
          </div>

          <!-- Question Grid -->
          <div id="question-grid" class="grid grid-cols-5 gap-2">
            {Array.from({ length: examInfo.totalQuestions }, (_, i) => (
              <button
                class={`q-nav-btn w-full aspect-square rounded-xl font-bold text-sm transition-all duration-200 ${
                  i === 0
                    ? 'bg-primary-500 text-white shadow-md ring-2 ring-primary-300'
                    : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                }`}
                data-q={i + 1}
              >
                {i + 1}
              </button>
            ))}
          </div>

          <!-- Action Buttons -->
          <div class="mt-6 space-y-3">
            <button id="mark-review-sidebar" class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-warning-50 text-warning-700 font-semibold rounded-xl hover:bg-warning-100 border border-warning-200 transition-all duration-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
              </svg>
              Mark for Review
            </button>
          </div>

          <!-- Summary -->
          <div class="mt-6 p-4 bg-slate-50 rounded-xl space-y-2">
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-600">Answered</span>
              <span id="answered-count" class="font-bold text-success-600">0</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-600">Marked</span>
              <span id="marked-count" class="font-bold text-warning-600">0</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-600">Unvisited</span>
              <span id="unvisited-count" class="font-bold text-slate-500">{examInfo.totalQuestions}</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-600">Not Answered</span>
              <span id="not-answered-count" class="font-bold text-danger-600">0</span>
            </div>
            <div class="pt-2 border-t border-slate-200">
              <div class="flex items-center justify-between">
                <span class="text-sm font-semibold text-slate-700">Total Questions</span>
                <span class="font-bold text-slate-900">{examInfo.totalQuestions}</span>
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <button id="submit-btn" class="w-full mt-5 py-3.5 bg-gradient-to-r from-danger-500 to-danger-600 text-white font-bold rounded-xl hover:from-danger-600 hover:to-danger-700 transition-all duration-200 shadow-lg hover:shadow-xl">
            Submit Exam
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Bottom Bar -->
    <div class="lg:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 shadow-lg z-30">
      <div class="flex items-center justify-between px-4 py-3">
        <button id="mobile-prev-btn" class="px-4 py-2.5 bg-slate-100 text-slate-700 font-semibold rounded-xl text-sm disabled:opacity-50" disabled>
          Prev
        </button>
        <button id="mobile-submit-btn" class="px-5 py-2.5 bg-danger-500 text-white font-bold rounded-xl text-sm">
          Submit
        </button>
        <button id="mobile-next-btn" class="px-4 py-2.5 bg-primary-500 text-white font-semibold rounded-xl text-sm">
          Next
        </button>
      </div>
    </div>
  </div>

  <!-- Submit Confirmation Modal -->
  <div id="submit-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all">
      <!-- Modal Header -->
      <div class="px-6 py-5 bg-gradient-to-r from-danger-500 to-danger-600">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">Submit Exam?</h3>
            <p class="text-white/80 text-sm">Review your progress before submitting</p>
          </div>
        </div>
      </div>

      <!-- Modal Body -->
      <div class="px-6 py-5">
        <div class="space-y-3">
          <div class="flex items-center justify-between p-3 bg-success-50 rounded-xl">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-success-100 flex items-center justify-center">
                <svg class="w-4 h-4 text-success-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-sm font-medium text-success-800">Answered</span>
            </div>
            <span id="modal-answered" class="text-lg font-bold text-success-600">0</span>
          </div>

          <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-slate-200 flex items-center justify-center">
                <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                </svg>
              </div>
              <span class="text-sm font-medium text-slate-800">Unanswered</span>
            </div>
            <span id="modal-unanswered" class="text-lg font-bold text-slate-600">0</span>
          </div>

          <div class="flex items-center justify-between p-3 bg-warning-50 rounded-xl">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-warning-100 flex items-center justify-center">
                <svg class="w-4 h-4 text-warning-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                </svg>
              </div>
              <span class="text-sm font-medium text-warning-800">Marked for Review</span>
            </div>
            <span id="modal-marked" class="text-lg font-bold text-warning-600">0</span>
          </div>

          <div class="flex items-center justify-between p-3 bg-primary-50 rounded-xl">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-primary-100 flex items-center justify-center">
                <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-sm font-medium text-primary-800">Time Remaining</span>
            </div>
            <span id="modal-time" class="text-lg font-bold text-primary-600 font-mono">30:00</span>
          </div>
        </div>

        <div class="mt-5 p-3 bg-danger-50 rounded-xl border border-danger-100">
          <p class="text-xs text-danger-700 text-center">
            <strong>Warning:</strong> Once submitted, you cannot change your answers.
          </p>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex gap-3">
        <button id="modal-cancel" class="flex-1 py-3 px-4 bg-white border border-slate-200 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 transition-all duration-200">
          Cancel
        </button>
        <button id="modal-confirm" class="flex-1 py-3 px-4 bg-gradient-to-r from-danger-500 to-danger-600 text-white font-bold rounded-xl hover:from-danger-600 hover:to-danger-700 transition-all duration-200 shadow-md">
          Confirm Submit
        </button>
      </div>
    </div>
  </div>

  <script define:vars={{ questions, totalQuestions: examInfo.totalQuestions, duration: examInfo.duration, examId: examInfo.id }}>
    (function () {
      // State
      let currentQuestion = 0;
      let answers = new Array(totalQuestions).fill(null);
      let marked = new Array(totalQuestions).fill(false);
      let visited = new Array(totalQuestions).fill(false);
      let timeRemaining = duration * 60;
      let timerInterval = null;

      // Elements
      const timerText = document.getElementById('timer-text');
      const timerDisplay = document.getElementById('timer-display');
      const currentQNum = document.getElementById('current-q-num');
      const questionBadge = document.getElementById('question-badge');
      const questionText = document.getElementById('question-text');
      const optionsContainer = document.getElementById('options-container');
      const questionGrid = document.getElementById('question-grid');
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      const clearBtn = document.getElementById('clear-btn');
      const submitBtn = document.getElementById('submit-btn');
      const markReviewBtn = document.getElementById('mark-review-btn');
      const markReviewText = document.getElementById('mark-review-text');
      const markReviewSidebar = document.getElementById('mark-review-sidebar');
      const markReviewBtnMobile = document.getElementById('mark-review-btn-mobile');
      const markReviewTextMobile = document.getElementById('mark-review-text-mobile');
      const answeredCount = document.getElementById('answered-count');
      const markedCount = document.getElementById('marked-count');
      const unvisitedCount = document.getElementById('unvisited-count');
      const notAnsweredCount = document.getElementById('not-answered-count');
      const submitModal = document.getElementById('submit-modal');
      const modalCancel = document.getElementById('modal-cancel');
      const modalConfirm = document.getElementById('modal-confirm');
      const modalAnswered = document.getElementById('modal-answered');
      const modalUnanswered = document.getElementById('modal-unanswered');
      const modalMarked = document.getElementById('modal-marked');
      const modalTime = document.getElementById('modal-time');
      const mobilePrevBtn = document.getElementById('mobile-prev-btn');
      const mobileNextBtn = document.getElementById('mobile-next-btn');
      const mobileSubmitBtn = document.getElementById('mobile-submit-btn');

      // Format time
      function formatTime(seconds) {
        const m = Math.floor(seconds / 60);
        const s = seconds % 60;
        return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
      }

      // Update timer display
      function updateTimer() {
        timerText.textContent = formatTime(timeRemaining);
        if (timeRemaining <= 300) {
          timerDisplay.classList.remove('bg-slate-900');
          timerDisplay.classList.add('bg-danger-600');
          timerText.classList.add('animate-pulse');
        }
        if (timeRemaining <= 0) {
          clearInterval(timerInterval);
          submitExam();
        }
        timeRemaining--;
      }

      // Start timer
      function startTimer() {
        timerInterval = setInterval(updateTimer, 1000);
      }

      // Render question
      function renderQuestion() {
        const q = questions[currentQuestion];
        currentQNum.textContent = currentQuestion + 1;
        questionBadge.textContent = currentQuestion + 1;
        questionText.textContent = q.text;
        visited[currentQuestion] = true;

        // Render options
        optionsContainer.innerHTML = '';
        q.options.forEach(function (opt) {
          const isSelected = answers[currentQuestion] === opt.label;
          const btn = document.createElement('button');
          btn.className = 'option-btn w-full text-left p-4 rounded-xl border-2 transition-all duration-200 flex items-center gap-4 ' +
            (isSelected
              ? 'border-primary-500 bg-primary-50'
              : 'border-slate-200 hover:border-primary-300 hover:bg-primary-50/50');
          btn.setAttribute('data-option', opt.label);
          btn.innerHTML =
            '<span class="w-10 h-10 rounded-xl flex items-center justify-center font-bold text-sm flex-shrink-0 option-label ' +
            (isSelected ? 'bg-primary-500 text-white' : 'bg-slate-100 text-slate-600') +
            '"></span>' +
            '<span class="text-sm lg:text-base text-slate-700 font-medium option-text"></span>' +
            '<svg class="w-5 h-5 text-primary-500 ml-auto transition-opacity duration-200 check-icon ' +
            (isSelected ? 'opacity-100' : 'opacity-0') +
            '" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
            '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
          btn.querySelector('.option-label').textContent = opt.label;
          btn.querySelector('.option-text').textContent = opt.text;

          btn.addEventListener('click', function () {
            selectAnswer(opt.label);
          });
          optionsContainer.appendChild(btn);
        });

        // Update navigation buttons
        prevBtn.disabled = currentQuestion === 0;
        mobilePrevBtn.disabled = currentQuestion === 0;
        nextBtn.disabled = currentQuestion === totalQuestions - 1;
        mobileNextBtn.textContent = currentQuestion === totalQuestions - 1 ? 'Last' : 'Next';

        // Update mark review state
        updateMarkReviewUI();

        // Update grid
        updateGrid();
        updateSummary();
      }

      // Select answer
      function selectAnswer(label) {
        answers[currentQuestion] = label;
        renderQuestion();
      }

      // Clear answer
      function clearAnswer() {
        answers[currentQuestion] = null;
        renderQuestion();
      }

      // Navigate to question
      function goToQuestion(index) {
        if (index >= 0 && index < totalQuestions) {
          currentQuestion = index;
          renderQuestion();
        }
      }

      // Toggle mark for review
      function toggleMarkReview() {
        marked[currentQuestion] = !marked[currentQuestion];
        updateMarkReviewUI();
        updateGrid();
        updateSummary();
      }

      // Update mark review UI
      function updateMarkReviewUI() {
        const isMarked = marked[currentQuestion];
        const markText = isMarked ? 'Unmark Review' : 'Mark Review';
        const markTextMobile = isMarked ? 'Unmark Review' : 'Mark for Review';
        if (markReviewText) markReviewText.textContent = markText;
        if (markReviewTextMobile) markReviewTextMobile.textContent = markTextMobile;
        if (isMarked) {
          if (markReviewBtn) markReviewBtn.classList.add('text-warning-600', 'bg-warning-50');
          if (markReviewBtnMobile) markReviewBtnMobile.classList.add('text-warning-600', 'bg-warning-50', 'border-warning-300');
          if (markReviewSidebar) markReviewSidebar.classList.add('ring-2', 'ring-warning-300');
        } else {
          if (markReviewBtn) markReviewBtn.classList.remove('text-warning-600', 'bg-warning-50');
          if (markReviewBtnMobile) markReviewBtnMobile.classList.remove('text-warning-600', 'bg-warning-50', 'border-warning-300');
          if (markReviewSidebar) markReviewSidebar.classList.remove('ring-2', 'ring-warning-300');
        }
      }

      // Update question grid
      function updateGrid() {
        const buttons = questionGrid.querySelectorAll('.q-nav-btn');
        buttons.forEach(function (btn, i) {
          btn.className = 'q-nav-btn w-full aspect-square rounded-xl font-bold text-sm transition-all duration-200';
          if (i === currentQuestion) {
            btn.classList.add('bg-primary-500', 'text-white', 'shadow-md', 'ring-2', 'ring-primary-300');
          } else if (marked[i]) {
            btn.classList.add('bg-warning-500', 'text-white');
          } else if (answers[i] !== null) {
            btn.classList.add('bg-success-500', 'text-white');
          } else if (visited[i]) {
            btn.classList.add('bg-slate-200', 'text-slate-700');
          } else {
            btn.classList.add('bg-slate-100', 'text-slate-500', 'hover:bg-slate-200');
          }
        });
      }

      // Update summary counts
      function updateSummary() {
        var ans = answers.filter(function (a) { return a !== null; }).length;
        var mrk = marked.filter(function (m) { return m; }).length;
        var vis = visited.filter(function (v) { return v; }).length;
        var unvis = totalQuestions - vis;
        var notAns = vis - ans;
        if (answeredCount) answeredCount.textContent = ans;
        if (markedCount) markedCount.textContent = mrk;
        if (unvisitedCount) unvisitedCount.textContent = unvis;
        if (notAnsweredCount) notAnsweredCount.textContent = notAns < 0 ? 0 : notAns;
      }

      // Submit exam
      function submitExam() {
        clearInterval(timerInterval);
        var ans = answers.filter(function (a) { return a !== null; }).length;
        var unans = totalQuestions - ans;
        var mrk = marked.filter(function (m) { return m; }).length;
        if (modalAnswered) modalAnswered.textContent = ans;
        if (modalUnanswered) modalUnanswered.textContent = unans;
        if (modalMarked) modalMarked.textContent = mrk;
        if (modalTime) modalTime.textContent = formatTime(timeRemaining > 0 ? timeRemaining : 0);
        submitModal.classList.remove('hidden');
        submitModal.classList.add('flex');
      }

      // Confirm submit
      function confirmSubmit() {
        submitModal.classList.remove('flex');
        submitModal.classList.add('hidden');
        alert('Exam submitted successfully!\n\nAnswered: ' + answers.filter(function (a) { return a !== null; }).length + '/' + totalQuestions);
        window.location.href = '/dashboard/exams';
      }

      // Cancel submit
      function cancelSubmit() {
        submitModal.classList.remove('flex');
        submitModal.classList.add('hidden');
        if (timeRemaining > 0) {
          startTimer();
        }
      }

      // Event listeners
      prevBtn.addEventListener('click', function () { goToQuestion(currentQuestion - 1); });
      nextBtn.addEventListener('click', function () { goToQuestion(currentQuestion + 1); });
      mobilePrevBtn.addEventListener('click', function () { goToQuestion(currentQuestion - 1); });
      mobileNextBtn.addEventListener('click', function () { goToQuestion(currentQuestion + 1); });
      clearBtn.addEventListener('click', clearAnswer);
      submitBtn.addEventListener('click', function () { clearInterval(timerInterval); submitExam(); });
      mobileSubmitBtn.addEventListener('click', function () { clearInterval(timerInterval); submitExam(); });
      markReviewBtn.addEventListener('click', toggleMarkReview);
      markReviewSidebar.addEventListener('click', toggleMarkReview);
      markReviewBtnMobile.addEventListener('click', toggleMarkReview);
      modalCancel.addEventListener('click', cancelSubmit);
      modalConfirm.addEventListener('click', confirmSubmit);

      // Question grid navigation
      questionGrid.querySelectorAll('.q-nav-btn').forEach(function (btn, i) {
        btn.addEventListener('click', function () { goToQuestion(i); });
      });

      // Keyboard navigation
      document.addEventListener('keydown', function (e) {
        if (submitModal.classList.contains('flex')) return;
        if (e.key === 'ArrowLeft') goToQuestion(currentQuestion - 1);
        if (e.key === 'ArrowRight') goToQuestion(currentQuestion + 1);
        if (e.key === '1' || e.key === 'a') selectAnswer('A');
        if (e.key === '2' || e.key === 'b') selectAnswer('B');
        if (e.key === '3' || e.key === 'c') selectAnswer('C');
        if (e.key === '4' || e.key === 'd') selectAnswer('D');
        if (e.key === 'm' || e.key === 'M') toggleMarkReview();
      });

      // Initialize
      startTimer();
      renderQuestion();
    })();
  </script>
</StudentLayout>
