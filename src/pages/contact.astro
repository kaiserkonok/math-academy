---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout title="Contact Us" description="Get in touch with Math Solution & Exam Center Mymensingh - We're here to help you succeed.">

  <!-- Hero Section -->
  <section class="relative overflow-hidden gradient-bg min-h-[40vh] flex items-center">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-white/5 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-white/5 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <span class="inline-block text-white/80 font-semibold text-sm uppercase tracking-wider mb-3">Get In Touch</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mb-4">Contact Us</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Have questions about enrollment, classes, or our programs? We'd love to hear from you.
      </p>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-20 bg-gradient-to-t from-slate-50 to-transparent"></div>
  </section>

  <!-- Contact Info Cards -->
  <section class="section-padding -mt-10 relative z-10">
    <div class="max-w-7xl mx-auto">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="card p-8 text-center group hover:-translate-y-1">
          <div class="w-16 h-16 rounded-2xl gradient-bg flex items-center justify-center mx-auto mb-5 group-hover:scale-110 transition-transform shadow-lg shadow-primary-500/25">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Our Address</h3>
          <p class="text-slate-500 leading-relaxed">Station Road, Mymensingh<br/>Mymensingh Division, Bangladesh</p>
        </div>

        <div class="card p-8 text-center group hover:-translate-y-1">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-secondary-500 to-secondary-700 flex items-center justify-center mx-auto mb-5 group-hover:scale-110 transition-transform shadow-lg shadow-secondary-500/25">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Phone</h3>
          <p class="text-slate-500 leading-relaxed">+880 1XXX-XXXXXX</p>
          <p class="text-sm text-slate-400 mt-1">Call us for inquiries</p>
        </div>

        <div class="card p-8 text-center group hover:-translate-y-1 sm:col-span-2 lg:col-span-1">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-accent-500 to-cyan-600 flex items-center justify-center mx-auto mb-5 group-hover:scale-110 transition-transform shadow-lg shadow-accent-500/25">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Email</h3>
          <p class="text-slate-500 leading-relaxed">info@mathsolutioncentre.com</p>
          <p class="text-sm text-slate-400 mt-1">We reply within 24 hours</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form & Map -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12">

        <!-- Contact Form -->
        <div>
          <span class="inline-block text-primary-600 font-semibold text-sm uppercase tracking-wider mb-3">Send a Message</span>
          <h2 class="text-3xl font-extrabold text-slate-900 mb-2">Get in Touch</h2>
          <p class="text-slate-500 mb-8">Fill out the form below and we'll get back to you as soon as possible.</p>

          <form class="space-y-5" action="#" method="POST">
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-semibold text-slate-700 mb-1.5">Full Name</label>
                <input type="text" id="name" name="name" required placeholder="Enter your full name" class="input-field" />
              </div>
              <div>
                <label for="email" class="block text-sm font-semibold text-slate-700 mb-1.5">Email Address</label>
                <input type="email" id="email" name="email" required placeholder="Enter your email" class="input-field" />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="phone" class="block text-sm font-semibold text-slate-700 mb-1.5">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="+880 1XXX-XXXXXX" class="input-field" />
              </div>
              <div>
                <label for="subject" class="block text-sm font-semibold text-slate-700 mb-1.5">Subject</label>
                <select id="subject" name="subject" class="input-field">
                  <option value="" disabled selected>Select a subject</option>
                  <option value="admission">Admission Inquiry</option>
                  <option value="classes">Class Information</option>
                  <option value="fees">Fee Structure</option>
                  <option value="exam">Exam Schedule</option>
                  <option value="other">Other</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-slate-700 mb-1.5">Your Message</label>
              <textarea id="message" name="message" rows="5" required placeholder="Write your message here..." class="input-field resize-none"></textarea>
            </div>

            <button type="submit" class="btn-primary w-full flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Send Message
            </button>
          </form>
        </div>

        <!-- Map & Hours -->
        <div class="space-y-6">

          <!-- Google Maps Placeholder -->
          <div class="card overflow-hidden">
            <div class="aspect-video bg-gradient-to-br from-slate-100 to-slate-200 flex flex-col items-center justify-center text-slate-400">
              <svg class="w-16 h-16 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <p class="font-medium text-slate-500">Google Maps</p>
              <p class="text-sm text-slate-400 mt-1">Station Road, Mymensingh</p>
            </div>
          </div>

          <!-- Office Hours -->
          <div class="card p-8">
            <h3 class="text-lg font-bold text-slate-900 mb-5 flex items-center gap-2">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Office Hours
            </h3>
            <div class="space-y-3">
              <div class="flex items-center justify-between py-3 border-b border-slate-100">
                <div class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-success-500"></span>
                  <span class="text-slate-700 font-medium">Saturday - Thursday</span>
                </div>
                <span class="text-slate-900 font-semibold">9:00 AM - 8:00 PM</span>
              </div>
              <div class="flex items-center justify-between py-3">
                <div class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-danger-500"></span>
                  <span class="text-slate-700 font-medium">Friday</span>
                </div>
                <span class="text-danger-500 font-semibold">Closed</span>
              </div>
            </div>
            <div class="mt-6 p-4 bg-primary-50 rounded-xl">
              <p class="text-sm text-primary-700 leading-relaxed">
                <span class="font-semibold">Note:</span> During Ramadan and national holidays, our schedule may change. Please call ahead to confirm.
              </p>
            </div>
          </div>

          <!-- Social Media -->
          <div class="card p-8">
            <h3 class="text-lg font-bold text-slate-900 mb-5">Follow Us</h3>
            <div class="flex gap-4">
              <a href="https://facebook.com/mathsolutioncentre" target="_blank" rel="noopener" class="flex items-center gap-3 px-5 py-3 rounded-xl bg-blue-50 text-blue-600 font-medium hover:bg-blue-100 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                Facebook Page
              </a>
              <a href="https://m.me/mathsolutioncentre" target="_blank" rel="noopener" class="flex items-center gap-3 px-5 py-3 rounded-xl bg-slate-100 text-slate-600 font-medium hover:bg-slate-200 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24 18.635 24 24.001 18.633 24.001 12.013 24.001 5.393 18.635.026 12.017.026z"/>
                </svg>
                Messenger
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

</PublicLayout>
